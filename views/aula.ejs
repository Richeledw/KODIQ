<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titlePage %> — Eduplat</title>

    <!-- Bootstrap 5 CDN con SRI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <!-- Font Awesome 6 CDN con SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- CSS personalizado -->
    <link rel="stylesheet" href="/css/styles.css">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">

    <!-- CSS específico del Aula Virtual -->
    <link rel="stylesheet" href="/css/aula.css">
</head>

<body class="aula-body">

    <!-- ── BARRA SUPERIOR AULA (Technical Studio) ── -->
    <header class="aula-topbar">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <!-- Left Info -->
            <div class="d-flex align-items-center gap-3">
                <a href="/curso/<%= curso.id %>" class="btn btn-sm btn-outline-secondary" title="Salir al detalle del curso">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="d-flex align-items-center gap-2">
                    <div class="brand-badge"><i class="fas fa-terminal"></i></div>
                    <div>
                        <span class="small font-mono text-muted d-block" style="font-size: 0.72rem; line-height: 1;">AULA VIRTUAL</span>
                        <h1 class="h6 mb-0 fw-bold font-heading text-dark text-truncate" style="max-width: 320px;">
                            <%= curso.titulo %>
                        </h1>
                    </div>
                </div>
            </div>

            <!-- Center Progress -->
            <div class="d-none d-md-flex align-items-center gap-3">
                <div style="width: 140px;">
                    <div class="progress" style="height: 6px; background-color: #E4E4E7;">
                        <div class="progress-bar bg-dark" id="progressBarDisplay" style="width: <%= porcentajeProgreso %>%;"></div>
                    </div>
                </div>
                <span class="small font-mono text-dark fw-semibold" id="progressPercentDisplay"><%= porcentajeProgreso %>%</span>
            </div>

            <!-- Right Actions -->
            <div class="d-flex align-items-center gap-2">
                <% if(porcentajeProgreso === 100 && proyecto && proyecto.estado === 'Completado') { %>
                    <a href="/curso/<%= curso.id %>/certificado" target="_blank" class="btn btn-sm btn-dark fw-semibold" style="font-size: 0.8rem;">
                        <i class="fas fa-award me-1 text-warning"></i> Certificado Oficial
                    </a>
                <% } %>
                <a href="/panel" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-th-large me-1"></i> Mi Panel
                </a>
            </div>
        </div>
    </header>

    <!-- ── CONTENIDO PRINCIPAL AULA ── -->
    <main class="container-fluid px-lg-4 py-4 flex-grow-1" style="max-width: 1540px;">
        <div class="row g-4">

            <!-- COLUMNA PRINCIPAL: PLAYER Y PESTAÑAS (8 COLS) -->
            <div class="col-lg-8">
                
                <% if(leccionActiva) { 
                    // Robust YouTube Video ID Parser
                    let embedUrl = '';
                    let rawUrl = (leccionActiva.videoUrl) ? leccionActiva.videoUrl.trim() : '';
                    let videoId = '';
                    
                    if (rawUrl.includes('youtu.be/')) {
                        videoId = rawUrl.split('youtu.be/')[1]?.split('?')[0]?.split('&')[0];
                    } else if (rawUrl.includes('youtube.com/watch')) {
                        try {
                            const u = new URL(rawUrl);
                            videoId = u.searchParams.get('v');
                        } catch(e) {
                            videoId = rawUrl.split('v=')[1]?.split('&')[0];
                        }
                    } else if (rawUrl.includes('youtube.com/embed/')) {
                        videoId = rawUrl.split('youtube.com/embed/')[1]?.split('?')[0]?.split('&')[0];
                    } else if (rawUrl.includes('youtube-nocookie.com/embed/')) {
                        videoId = rawUrl.split('youtube-nocookie.com/embed/')[1]?.split('?')[0]?.split('&')[0];
                    }

                    if (videoId) {
                        embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1&enablejsapi=1`;
                    } else if (rawUrl) {
                        embedUrl = rawUrl;
                    } else {
                        embedUrl = 'https://www.youtube-nocookie.com/embed/kUm245hmJwo?rel=0';
                    }
                %>
                    <!-- Reproductor de Video Resiliente -->
                    <div class="video-container">
                        <% if(rawUrl.endsWith('.mp4')) { %>
                            <video controls poster="/img/banner-video.jpg">
                                <source src="<%= rawUrl %>" type="video/mp4">
                                Tu navegador no soporta video HTML5.
                            </video>
                        <% } else { %>
                            <iframe 
                                id="playerIframe"
                                src="<%= embedUrl %>" 
                                title="<%= leccionActiva.titulo %>" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                referrerpolicy="strict-origin-when-cross-origin"
                                allowfullscreen>
                            </iframe>
                        <% } %>
                    </div>

                    <!-- Barra de Controles y Navegación de la Lección -->
                    <div class="player-bar">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-light text-dark border font-mono" style="font-size: 0.72rem;">
                                    <%= leccionActiva.moduloTitulo || 'MÓDULO DE APRENDIZAJE' %>
                                </span>
                                <% if(videoId) { %>
                                    <a href="https://www.youtube.com/watch?v=<%= videoId %>" target="_blank" class="small text-muted font-mono text-decoration-none" style="font-size: 0.72rem;" title="Abrir externamente si el reproductor está bloqueado">
                                        <i class="fas fa-external-link-alt me-1"></i>Abrir en YouTube
                                    </a>
                                <% } %>
                            </div>
                            <h5 class="fw-bold text-dark mb-0 font-heading"><%= leccionActiva.titulo %></h5>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <% const estaCompletada = leccionesCompletadas.includes(leccionActiva.id); %>
                            <button type="button" 
                                    class="btn btn-sm <%= estaCompletada ? 'btn-dark' : 'btn-outline-dark' %> fw-semibold d-flex align-items-center gap-1"
                                    id="btnCompletarLeccion"
                                    onclick="toggleLeccionCompletada('<%= curso.id %>', '<%= leccionActiva.id %>')">
                                <i class="fas <%= estaCompletada ? 'fa-check-circle' : 'fa-circle' %>" id="iconCheckLeccion"></i>
                                <span id="textCheckLeccion"><%= estaCompletada ? 'Completada' : 'Marcar como Completada' %></span>
                            </button>

                            <% if(leccionAnterior) { %>
                                <a href="/curso/<%= curso.id %>/aula/<%= leccionAnterior.id %>" class="btn btn-sm btn-outline-secondary" title="Lección anterior">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            <% } %>

                            <% if(leccionSiguiente) { %>
                                <a href="/curso/<%= curso.id %>/aula/<%= leccionSiguiente.id %>" class="btn btn-sm btn-dark fw-semibold" title="Siguiente lección">
                                    Siguiente <i class="fas fa-chevron-right ms-1"></i>
                                </a>
                            <% } %>
                        </div>
                    </div>

                <% } else { %>
                    <div class="alert alert-light py-5 text-center content-card border">
                        <i class="fas fa-laptop-code fa-3x text-muted mb-3 opacity-50"></i>
                        <h4 class="fw-bold font-heading text-dark">Este curso está preparando sus clases</h4>
                        <p class="text-secondary small mb-0">Selecciona un módulo del índice o interactúa con la terminal de pruebas.</p>
                    </div>
                <% } %>

                <!-- ── PESTAÑAS: EXPLICACIÓN, TERMINAL, QUIZ, PROYECTO Y RECURSOS ── -->
                <div class="mt-4">
                    <ul class="nav nav-tabs aula-tabs border-bottom" id="aulaTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tab-explicacion" data-bs-toggle="tab" data-bs-target="#pills-explicacion" type="button" role="tab">
                                <i class="fas fa-file-alt me-1 text-muted"></i> Explicación Teórica
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-terminal" data-bs-toggle="tab" data-bs-target="#pills-terminal" type="button" role="tab">
                                <i class="fas fa-terminal me-1 text-dark"></i> Terminal & Tareas Prácticas
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-quiz" data-bs-toggle="tab" data-bs-target="#pills-quiz" type="button" role="tab">
                                <i class="fas fa-tasks me-1 text-muted"></i> Cuestionario de Módulo
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-proyecto" data-bs-toggle="tab" data-bs-target="#pills-proyecto" type="button" role="tab">
                                <i class="fas fa-laptop-code me-1 text-muted"></i> Mi Proyecto del Curso
                                <% if(proyecto && proyecto.estado === 'Completado') { %>
                                    <span class="badge bg-dark ms-1" style="font-size:0.65rem;">Completado</span>
                                <% } else if(proyecto && proyecto.estado === 'En Revisión') { %>
                                    <span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem;">En Revisión</span>
                                <% } %>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-recursos" data-bs-toggle="tab" data-bs-target="#pills-recursos" type="button" role="tab">
                                <i class="fas fa-download me-1 text-muted"></i> Recursos
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="aulaTabContent">
                        
                        <!-- PESTAÑA 1: EXPLICACIÓN TEÓRICA -->
                        <div class="tab-pane fade show active" id="pills-explicacion" role="tabpanel">
                            <div class="content-card">
                                <% if(leccionActiva && leccionActiva.explicacionDetallada) { %>
                                    <div class="lh-lg text-secondary" style="font-size: 0.98rem; white-space: pre-line;">
                                        <%= leccionActiva.explicacionDetallada %>
                                    </div>
                                <% } else { %>
                                    <p class="text-secondary mb-0">En esta lección cubrimos los conceptos clave del video. Asegúrate de tomar notas y practicar con la terminal interactiva.</p>
                                <% } %>

                                <% if(leccionActiva && leccionActiva.codigoEjemplo) { %>
                                    <div class="mt-4">
                                        <h6 class="fw-bold text-dark font-heading"><i class="fas fa-code me-2 text-muted"></i>Código de Ejemplo</h6>
                                        <div class="code-container">
                                            <div class="code-header">
                                                <span><%= leccionActiva.lenguajeCodigo || 'javascript' %></span>
                                                <button class="btn btn-sm btn-outline-light py-0 px-2 font-mono" style="font-size:0.75rem;" onclick="copiarCodigo()">
                                                    <i class="fas fa-copy me-1"></i> Copiar
                                                </button>
                                            </div>
                                            <pre class="code-block" id="blockCodeSnippet"><code><%= leccionActiva.codigoEjemplo %></code></pre>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- PESTAÑA 2: TERMINAL INTERACTIVA & TAREAS PRÁCTICAS -->
                        <div class="tab-pane fade" id="pills-terminal" role="tabpanel">
                            <div class="content-card">
                                <div class="row g-4">
                                    <!-- Lista de Tareas Prácticas -->
                                    <div class="col-md-5">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h6 class="fw-bold font-heading text-dark mb-0">
                                                    <i class="fas fa-clipboard-list me-1 text-muted"></i> Tareas de Prueba
                                                </h6>
                                                <span class="badge bg-dark text-white font-mono" id="tareasProgressBadge" style="font-size: 0.72rem;">0/3 completadas</span>
                                            </div>
                                            <p class="small text-secondary mb-3">Ejecuta los comandos en la consola lateral para completar los ejercicios prácticos de este módulo:</p>
                                            
                                            <div class="list-group list-group-flush border-0">
                                                <div class="list-group-item bg-transparent px-0 py-2 border-bottom d-flex align-items-center gap-2" id="task-1">
                                                    <i class="far fa-circle text-muted" id="task-icon-1"></i>
                                                    <div>
                                                        <span class="small fw-semibold text-dark d-block">Tarea 1: Inspeccionar archivos</span>
                                                        <code class="small font-mono text-muted">ls</code> o <code class="small font-mono text-muted">dir</code>
                                                    </div>
                                                </div>
                                                <div class="list-group-item bg-transparent px-0 py-2 border-bottom d-flex align-items-center gap-2" id="task-2">
                                                    <i class="far fa-circle text-muted" id="task-icon-2"></i>
                                                    <div>
                                                        <span class="small fw-semibold text-dark d-block">Tarea 2: Ejecutar suite de pruebas</span>
                                                        <code class="small font-mono text-muted">npm test</code>
                                                    </div>
                                                </div>
                                                <div class="list-group-item bg-transparent px-0 py-2 d-flex align-items-center gap-2" id="task-3">
                                                    <i class="far fa-circle text-muted" id="task-icon-3"></i>
                                                    <div>
                                                        <span class="small fw-semibold text-dark d-block">Tarea 3: Ejecutar solución</span>
                                                        <code class="small font-mono text-muted">node index.js</code> o <code class="small font-mono text-muted">cat index.html</code>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-3 pt-3 border-top small text-muted font-mono" style="font-size: 0.75rem;">
                                                <i class="fas fa-info-circle me-1"></i> Escribe <span class="text-dark fw-bold">help</span> en la consola para ver los comandos soportados.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Consola Terminal Interactiva -->
                                    <div class="col-md-7">
                                        <div class="terminal-window">
                                            <div class="terminal-header">
                                                <div class="terminal-dots">
                                                    <div class="terminal-dot" style="background:#EF4444;"></div>
                                                    <div class="terminal-dot" style="background:#F59E0B;"></div>
                                                    <div class="terminal-dot" style="background:#10B981;"></div>
                                                </div>
                                                <span class="font-mono">bash — workspace/<%= curso.id %></span>
                                                <span class="text-muted" style="font-size: 0.7rem;">v20.10.0</span>
                                            </div>
                                            <div class="terminal-body" id="terminalOutput">
                                                <div class="terminal-line text-muted">Eduplat Cloud Sandbox Environment [Node.js / Express / Git]</div>
                                                <div class="terminal-line text-muted">Entorno interactivo listo para el curso: <%= curso.titulo %></div>
                                                <div class="terminal-line text-muted">Escribe 'help' o ejecuta los comandos de las tareas.</div>
                                                <div class="terminal-line">--------------------------------------------------</div>
                                            </div>
                                            <div class="p-2 px-3 border-top" style="border-color: #27272A; background: #09090B;">
                                                <form id="terminalForm" class="terminal-input-wrapper m-0">
                                                    <span class="terminal-prompt">$</span>
                                                    <input type="text" id="terminalInput" class="terminal-input" autocomplete="off" spellcheck="false" placeholder="Escribe un comando (ej: npm test, ls, node index.js)...">
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PESTAÑA 3: CUESTIONARIO INTERACTIVO DE MÓDULO (QUIZ) -->
                        <div class="tab-pane fade" id="pills-quiz" role="tabpanel">
                            <div class="content-card">
                                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                                    <div>
                                        <h5 class="fw-bold font-heading mb-1 text-dark">
                                            <i class="fas fa-question-circle text-muted me-2"></i>Evaluación Rápida del Módulo
                                        </h5>
                                        <p class="text-secondary small mb-0">Valida los conceptos clave vistos en las lecciones antes de avanzar.</p>
                                    </div>
                                    <span class="badge bg-light text-secondary border font-mono">3 Preguntas</span>
                                </div>

                                <div id="contenedorQuiz">
                                    <form id="formQuizModulo" action="/curso/<%= curso.id %>/modulo/<%= leccionActiva && leccionActiva.moduloId ? leccionActiva.moduloId : (curso.modulos[0] && curso.modulos[0]._id) %>/quiz/evaluar" method="POST">
                                        <div class="mb-4 p-3 bg-light rounded-3 border">
                                            <p class="fw-semibold text-dark mb-2">1. ¿Cuál es el principio arquitectónico fundamental para proyectos escalables?</p>
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="radio" name="resp_0" id="q0_op0" value="0" required>
                                                <label class="form-check-label text-secondary" for="q0_op0">Estructurar código limpio y modular con separación de responsabilidades</label>
                                            </div>
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="radio" name="resp_0" id="q0_op1" value="1">
                                                <label class="form-check-label text-secondary" for="q0_op1">Escribir toda la lógica en un solo archivo para evitar importar módulos</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="resp_0" id="q0_op2" value="2">
                                                <label class="form-check-label text-secondary" for="q0_op2">Desactivar las validaciones para acelerar el desarrollo</label>
                                            </div>
                                        </div>

                                        <div class="mb-4 p-3 bg-light rounded-3 border">
                                            <p class="fw-semibold text-dark mb-2">2. ¿Por qué es fundamental la validación estricta de esquemas antes de guardar en la base de datos?</p>
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="radio" name="resp_1" id="q1_op0" value="0" required>
                                                <label class="form-check-label text-secondary" for="q1_op0">Prevenir inyecciones, caídas del servidor y asegurar la integridad de datos</label>
                                            </div>
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="radio" name="resp_1" id="q1_op1" value="1">
                                                <label class="form-check-label text-secondary" for="q1_op1">Solo es un requisito visual sin impacto en la seguridad</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="resp_1" id="q1_op2" value="2">
                                                <label class="form-check-label text-secondary" for="q1_op2">No es necesario en entornos web modernos</label>
                                            </div>
                                        </div>

                                        <div class="mb-4 p-3 bg-light rounded-3 border">
                                            <p class="fw-semibold text-dark mb-2">3. ¿Qué patrón arquitectónico desacopla vistas, controladores y persistencia en Eduplat?</p>
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="radio" name="resp_2" id="q2_op0" value="0" required>
                                                <label class="form-check-label text-secondary" for="q2_op0">Modelo - Vista - Controlador (MVC)</label>
                                            </div>
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="radio" name="resp_2" id="q2_op1" value="1">
                                                <label class="form-check-label text-secondary" for="q2_op1">Script monolítico en un único archivo</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="resp_2" id="q2_op2" value="2">
                                                <label class="form-check-label text-secondary" for="q2_op2">Exposición de secretos en el cliente</label>
                                            </div>
                                        </div>

                                        <button type="submit" class="btn btn-dark fw-semibold px-4" id="btnEvaluarQuiz">
                                            <i class="fas fa-check-double me-1"></i> Evaluar Respuestas
                                        </button>
                                    </form>

                                    <!-- Resultado interactivo -->
                                    <div id="resultadoQuizBox" class="mt-4 p-4 rounded-3 border d-none">
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            <div id="quizScoreIcon" class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;"></div>
                                            <div>
                                                <h6 class="fw-bold text-dark mb-0 font-heading" id="quizScoreTitle"></h6>
                                                <small class="text-muted" id="quizScoreMsg"></small>
                                            </div>
                                        </div>
                                        <div id="quizDetallesFeedback" class="small mb-3"></div>
                                        <button type="button" class="btn btn-outline-secondary btn-sm fw-medium" id="btnReintentarQuiz">
                                            <i class="fas fa-redo me-1"></i> Reintentar Cuestionario
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PESTAÑA 4: PROYECTO PRÁCTICO -->
                        <div class="tab-pane fade" id="pills-proyecto" role="tabpanel">
                            <div class="content-card">
                                <div class="p-3 bg-light rounded-3 border mb-4">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                        <div>
                                            <h5 class="fw-bold font-heading mb-1 text-dark">
                                                <i class="fas fa-briefcase me-2 text-muted"></i>Consigna del Proyecto Integrador
                                            </h5>
                                            <p class="text-secondary small mb-2"><%= curso.proyectoConsigna?.titulo || 'Proyecto Práctico Final' %></p>
                                        </div>
                                        <span class="badge bg-dark text-white font-mono px-3 py-2">
                                            ESTADO: <%= proyecto?.estado || 'En Progreso' %>
                                        </span>
                                    </div>
                                    <p class="small text-secondary mb-0"><%= curso.proyectoConsigna?.descripcion || 'Construye tu entrega práctica final.' %></p>
                                </div>

                                <form action="/curso/<%= curso.id %>/proyecto/guardar" method="POST">
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold text-dark">Repositorio Git</label>
                                            <input type="url" name="repositorioUrl" class="form-control" value="<%= proyecto?.repositorioUrl || '' %>" placeholder="https://github.com/usuario/proyecto">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold text-dark">Despliegue en Vivo</label>
                                            <input type="url" name="despliegueUrl" class="form-control" value="<%= proyecto?.despliegueUrl || '' %>" placeholder="https://proyecto.vercel.app">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold text-dark">Video Demo (Loom/YouTube)</label>
                                            <input type="url" name="videoDemoUrl" class="form-control" value="<%= proyecto?.videoDemoUrl || '' %>" placeholder="https://loom.com/share/...">
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small fw-semibold text-dark">Bitácora / Notas de Avance</label>
                                            <textarea name="notasAvance" class="form-control" rows="3" placeholder="Registra tus avances o dudas..."><%= proyecto?.notasAvance || '' %></textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold text-dark">Estado de la Entrega</label>
                                            <select name="estado" class="form-select">
                                                <option value="En Progreso" <%= (!proyecto || proyecto.estado === 'En Progreso') ? 'selected' : '' %>>En Progreso (Borrador)</option>
                                                <option value="En Revisión" <%= (proyecto && proyecto.estado === 'En Revisión') ? 'selected' : '' %>>Enviar a Revisión Docente</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end">
                                        <button type="submit" class="btn btn-dark fw-semibold px-4">
                                            <i class="fas fa-save me-1"></i> Guardar Avance del Proyecto
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- PESTAÑA 5: RECURSOS DESCARGABLES -->
                        <div class="tab-pane fade" id="pills-recursos" role="tabpanel">
                            <div class="content-card">
                                <h5 class="fw-bold font-heading text-dark mb-3">Recursos de Apoyo</h5>
                                <% if(leccionActiva && leccionActiva.recursos && leccionActiva.recursos.length > 0) { %>
                                    <div class="list-group list-group-flush border rounded-3 mb-4">
                                        <% leccionActiva.recursos.forEach(r => { %>
                                            <a href="<%= r.url %>" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                                                <div>
                                                    <strong class="text-dark"><%= r.titulo %></strong>
                                                    <small class="text-muted d-block"><%= r.descripcion || r.url %></small>
                                                </div>
                                                <i class="fas fa-external-link-alt text-muted"></i>
                                            </a>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <p class="text-muted small">No hay archivos específicos adjuntos a esta lección.</p>
                                <% } %>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- COLUMNA LATERAL: ÍNDICE DE MÓDULOS Y LECCIONES (4 COLS) -->
            <div class="col-lg-4">
                <% if(porcentajeProgreso === 100 && proyecto && proyecto.estado === 'Completado') { %>
                    <div class="p-3 mb-3 bg-white border rounded-3 shadow-sm text-center">
                        <div class="d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px; border-radius: 50%; background: #18181B; color: #FFFFFF;">
                            <i class="fas fa-award fs-5"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 font-heading">¡Certificación Habilitada!</h6>
                        <p class="small text-secondary mb-3">Has completado el 100% de las lecciones y tu proyecto ha sido aprobado.</p>
                        <a href="/curso/<%= curso.id %>/certificado" target="_blank" class="btn btn-dark btn-sm fw-semibold w-100">
                            <i class="fas fa-certificate me-1"></i> Ver Certificado Oficial
                        </a>
                    </div>
                <% } %>

                <div class="syllabus-sidebar">
                    <div class="syllabus-header d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold text-dark mb-0 font-heading">Contenido del Curso</h6>
                            <small class="text-muted font-mono"><%= todasLasLecciones.length %> lecciones estructuradas</small>
                        </div>
                        <span class="badge bg-light text-dark border font-mono">
                            <%= leccionesCompletadas.length %>/<%= todasLasLecciones.length %> listos
                        </span>
                    </div>

                    <div class="syllabus-body">
                        <% if(curso.modulos && curso.modulos.length > 0) { %>
                            <div class="accordion accordion-flush" id="accordionModulos">
                                <% curso.modulos.forEach((modulo, mIndex) => { %>
                                    <div class="accordion-item border-0">
                                        <h2 class="accordion-header" id="heading<%= mIndex %>">
                                            <button class="accordion-button <%= mIndex === 0 ? '' : 'collapsed' %> py-3 bg-light fw-semibold text-dark font-heading" style="font-size: 0.88rem;" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= mIndex %>">
                                                <i class="fas fa-folder text-muted me-2"></i>
                                                <span class="text-truncate" style="max-width: 220px;"><%= modulo.titulo %></span>
                                            </button>
                                        </h2>
                                        <div id="collapse<%= mIndex %>" class="accordion-collapse collapse <%= mIndex === 0 ? 'show' : '' %>" data-bs-parent="#accordionModulos">
                                            <div class="accordion-body p-0">
                                                <% if(modulo.lecciones && modulo.lecciones.length > 0) { %>
                                                    <% modulo.lecciones.forEach(lec => { 
                                                        const isCompleted = leccionesCompletadas.includes(lec.id);
                                                        const isCurrent = leccionActiva && leccionActiva.id === lec.id;
                                                    %>
                                                        <a href="/curso/<%= curso.id %>/aula/<%= lec.id %>" class="lesson-item <%= isCurrent ? 'active' : '' %>">
                                                            <div class="lesson-check <%= isCompleted ? 'completed' : 'pending' %>">
                                                                <i class="fas fa-check"></i>
                                                            </div>
                                                            <div class="flex-grow-1 text-truncate">
                                                                <div class="text-truncate fw-medium"><%= lec.titulo %></div>
                                                                <small class="text-muted font-mono" style="font-size: 0.72rem;"><%= lec.duracion || '15 min' %></small>
                                                            </div>
                                                        </a>
                                                    <% }) %>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- Bootstrap 5 JS con SRI y defer -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous" defer></script>

    <!-- Lógica de Terminal Interactiva, Quizzes y Lecciones desacoplada -->
    <script src="/js/aula.js"></script>
    <%- include('partials/sw-register') %>
</body>

</html>
