<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificado de Finalización - <%= curso.titulo %> - Eduplat</title>
    <meta name="robots" content="noindex, nofollow">

    <!-- Bootstrap 5 CDN con SRI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS del Sistema de Diseño Technical Studio -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        body {
            background-color: var(--canvas-bg);
            font-family: var(--font-body);
            color: var(--brand-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .cert-container {
            max-width: 900px;
            margin: 2rem auto;
            background: #FFFFFF;
            border: 2px solid var(--border-subtle);
            border-radius: 16px;
            box-shadow: var(--shadow-lg);
            padding: 3.5rem 4rem;
            position: relative;
            overflow: hidden;
        }

        .cert-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: var(--brand-dark);
        }

        .cert-brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            margin-bottom: 2rem;
        }

        .cert-brand-icon {
            width: 44px;
            height: 44px;
            background: var(--brand-dark);
            color: #FFFFFF;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .cert-student-name {
            font-family: var(--font-heading);
            font-size: 2.4rem;
            font-weight: 800;
            color: var(--brand-dark);
            border-bottom: 2px solid var(--border-subtle);
            display: inline-block;
            padding-bottom: 0.5rem;
            margin: 1.5rem 0;
        }

        .cert-course-title {
            font-family: var(--font-heading);
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--brand-primary);
            margin-bottom: 1rem;
        }

        .cert-stamp {
            width: 90px;
            height: 90px;
            border: 2px dashed var(--border-subtle);
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--brand-dark);
            margin: 0 auto;
        }

        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
            }
            .cert-container {
                box-shadow: none !important;
                border: 1px solid #ccc !important;
                margin: 0 !important;
                padding: 2rem !important;
                max-width: 100% !important;
            }
        }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
</head>

<body>
    <!-- Barra de acciones superior (No se imprime) -->
    <div class="no-print bg-white border-bottom py-3 px-4">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/curso/<%= curso.id %>/aula" class="btn btn-outline-secondary btn-sm fw-medium">
                <i class="fas fa-arrow-left me-1"></i> Volver al Aula
            </a>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-primary fw-semibold btn-sm shadow-sm" style="background:var(--brand-dark);border:none;">
                    <i class="fas fa-print me-1"></i> Imprimir / Guardar en PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Documento Certificado Oficial -->
    <main id="main-content" class="flex-grow-1 d-flex align-items-center py-4">
        <div class="container">
            <div class="cert-container text-center">
                <!-- Marca institucional -->
                <div class="cert-brand">
                    <div class="cert-brand-icon">
                        <i class="fas fa-terminal"></i>
                    </div>
                    <span class="fs-3 fw-bold font-heading">Eduplat</span>
                </div>

                <div class="text-uppercase tracking-wider font-mono text-muted small mb-2" style="letter-spacing: 0.15em;">
                    CERTIFICADO DE FINALIZACIÓN ACADÉMICA Y TÉCNICA
                </div>

                <p class="text-secondary small mb-2">Por cuanto ha completado satisfactoriamente todos los módulos y la evaluación práctica de:</p>

                <div class="cert-student-name">
                    <%= user.nombre %>
                </div>

                <div class="mb-3">
                    <span class="text-muted small">Ha culminado con éxito el programa curricular de:</span>
                    <div class="cert-course-title mt-1">
                        <%= curso.titulo %>
                    </div>
                </div>

                <p class="text-secondary small mx-auto mb-4" style="max-width: 600px; line-height: 1.6;">
                    Demostrando dominio de las competencias técnicas, cumplimiento del 100% de las lecciones lectivas y la entrega, revisión y aprobación docente del proyecto práctico final: 
                    <strong class="text-dark">"<%= proyecto.titulo %>"</strong>.
                </p>

                <!-- Sellos y Firmas -->
                <div class="row align-items-center justify-content-between mt-5 pt-4 border-top">
                    <div class="col-sm-4 text-sm-start text-center mb-3 mb-sm-0">
                        <div class="small font-mono text-muted">FECHA DE EMISIÓN</div>
                        <div class="fw-semibold text-dark">
                            <%= new Date().toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                        </div>
                        <div class="small text-muted font-mono mt-1">Carga lectiva: <%= curso.duracion || '10 horas' %></div>
                    </div>

                    <div class="col-sm-4 text-center mb-3 mb-sm-0">
                        <div class="cert-stamp">
                            <i class="fas fa-certificate fa-2x mb-1 text-primary"></i>
                            <span class="font-mono" style="font-size: 0.65rem; font-weight: 700;">VERIFICADO</span>
                        </div>
                    </div>

                    <div class="col-sm-4 text-sm-end text-center">
                        <div class="small font-mono text-muted">ID DE CREDENCIAL</div>
                        <div class="font-mono fw-bold text-dark" style="font-size: 0.85rem;">
                            EDU-<%= hashCertificado %>
                        </div>
                        <div class="small text-success font-mono mt-1">
                            <i class="fas fa-shield-alt me-1"></i> Estado: Válido y Registrado
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>

</html>
