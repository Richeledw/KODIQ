<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuración de Cuenta - Eduplat</title>

    <!-- Bootstrap 5 CDN con SRI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">

    <!-- Font Awesome 6 CDN con SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS personalizado -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        body {
            font-family: var(--font-body);
            background-color: var(--canvas-bg);
            color: var(--brand-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }

        .settings-card {
            background: #FFFFFF;
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
        }

        .settings-nav .list-group-item {
            font-size: 0.9rem;
            font-weight: 500;
            padding: 0.85rem 1.15rem;
            color: #4B5563;
            border: 1px solid transparent;
            border-radius: 8px !important;
            margin-bottom: 4px;
            transition: all 0.15s ease;
        }

        .settings-nav .list-group-item:hover {
            background-color: #F4F4F5;
            color: var(--brand-dark);
        }

        .settings-nav .list-group-item.active {
            background-color: #F4F4F5;
            color: var(--brand-primary);
            font-weight: 600;
            border-color: var(--border-subtle);
        }

        .danger-zone-box {
            background: #FEF2F2;
            border: 1px solid #FECACA;
            border-radius: 10px;
            padding: 1.5rem;
        }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
</head>

<body>
    <!-- Header/Navbar -->
    <%- include('partials/navbar') %>

    <main id="main-content" class="py-5">
        <div class="container">
            <!-- Header Section -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-4 mb-4 border-bottom">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-light text-secondary font-mono border" style="font-size: 0.75rem;">CONFIGURACIÓN</span>
                        <span class="text-muted small">• <%= user.rol.toUpperCase() %></span>
                    </div>
                    <h1 class="h3 fw-bold font-heading mb-0 text-dark">Ajustes de Cuenta</h1>
                </div>
                <div class="d-flex gap-2">
                    <a href="/panel" class="btn btn-outline-secondary btn-sm fw-medium">
                        <i class="fas fa-arrow-left me-1"></i> Volver a mi panel
                    </a>
                </div>
            </div>

            <!-- Alertas Flash -->
            <% if (locals.success_msg && locals.success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                    <i class="fas fa-check-circle me-2 fs-5"></i>
                    <div><%= locals.success_msg %></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <% if (locals.error_msg && locals.error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                    <i class="fas fa-exclamation-circle me-2 fs-5"></i>
                    <div><%= locals.error_msg %></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- Layout principal -->
            <div class="row g-4">
                <!-- Sidebar Tabs -->
                <div class="col-lg-3">
                    <div class="settings-card p-3 settings-nav">
                        <div class="list-group list-group-flush border-0">
                            <a href="#tab-perfil" class="list-group-item list-group-item-action active" data-bs-toggle="list">
                                <i class="fas fa-user-circle me-2 text-muted"></i> Información de Perfil
                            </a>
                            <a href="#tab-seguridad" class="list-group-item list-group-item-action" data-bs-toggle="list">
                                <i class="fas fa-shield-alt me-2 text-muted"></i> Seguridad y Acceso
                            </a>
                            <a href="#tab-notificaciones" class="list-group-item list-group-item-action" data-bs-toggle="list">
                                <i class="fas fa-bell me-2 text-muted"></i> Notificaciones
                            </a>
                            <a href="#tab-peligro" class="list-group-item list-group-item-action text-danger" data-bs-toggle="list">
                                <i class="fas fa-trash-alt me-2"></i> Zona de Peligro
                            </a>
                        </div>
                    </div>

                    <!-- Mini resumen de cuenta -->
                    <div class="settings-card p-3 mt-3">
                        <div class="small text-muted mb-1 font-mono">REGISTRO</div>
                        <div class="small fw-semibold text-dark mb-2">
                            <%= user.creadoEn ? new Date(user.creadoEn).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }) : 'Miembro activo' %>
                        </div>
                        <div class="small text-muted mb-1 font-mono">ESTADO</div>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">
                            <i class="fas fa-check-circle me-1"></i> Cuenta Verificada
                        </span>
                    </div>
                </div>

                <!-- Tab Panels -->
                <div class="col-lg-9">
                    <div class="tab-content">
                        <!-- Tab 1: Perfil -->
                        <div class="tab-pane fade show active" id="tab-perfil">
                            <div class="settings-card p-4">
                                <div class="border-bottom pb-3 mb-4">
                                    <h4 class="h5 fw-bold font-heading mb-1 text-dark">Información Personal</h4>
                                    <p class="text-muted small mb-0">Actualiza tus datos de contacto y la información visible en tu expediente académico.</p>
                                </div>

                                <!-- Avatar Card / Subida con Multer -->
                                <div class="p-3 bg-light rounded-3 border mb-4 d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="position-relative">
                                            <% if (user.avatar && !user.avatar.includes('default-avatar')) { %>
                                                <img src="<%= user.avatar %>" alt="<%= user.nombre %>" class="rounded-circle border" style="width: 64px; height: 64px; object-fit: cover;">
                                            <% } else { %>
                                                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold font-mono" style="width: 64px; height: 64px; font-size: 1.4rem;">
                                                    <%= user.nombre.charAt(0).toUpperCase() %>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark mb-0">Foto de Perfil</div>
                                            <small class="text-muted font-mono" style="font-size: 0.75rem;">JPG, PNG o WebP (Máx. 2MB)</small>
                                        </div>
                                    </div>
                                    <form action="/configuracion/avatar" method="POST" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
                                        <input type="file" name="avatar" id="inputAvatar" class="form-control form-control-sm" accept="image/png, image/jpeg, image/webp" required style="max-width: 220px;">
                                        <button type="submit" class="btn btn-dark btn-sm fw-semibold text-nowrap">
                                            <i class="fas fa-upload me-1"></i> Subir
                                        </button>
                                    </form>
                                </div>

                                <form action="/configuracion/perfil" method="POST">
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label for="nombre" class="form-label fw-semibold text-dark small">Nombre Completo <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="nombre" name="nombre" value="<%= user.nombre %>" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="email" class="form-label fw-semibold text-dark small">Correo Electrónico <span class="text-danger">*</span></label>
                                            <input type="email" class="form-control" id="email" name="email" value="<%= user.email %>" required>
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label for="telefono" class="form-label fw-semibold text-dark small">Teléfono / WhatsApp</label>
                                            <input type="tel" class="form-control" id="telefono" name="telefono" value="<%= user.telefono || '' %>" placeholder="+54 9 11 2345 6789">
                                        </div>
                                        <div class="col-md-6">
                                            <label for="ciudad" class="form-label fw-semibold text-dark small">Ciudad y País</label>
                                            <input type="text" class="form-control" id="ciudad" name="ciudad" value="<%= user.ciudad || '' %>" placeholder="Buenos Aires, Argentina">
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label for="bio" class="form-label fw-semibold text-dark small">Biografía Técnica o Intereses</label>
                                        <textarea class="form-control" id="bio" name="bio" rows="3" placeholder="Describe brevemente tus intereses de aprendizaje o tecnologías que dominas..."><%= user.bio || '' %></textarea>
                                        <div class="form-text">Esta información permite a tus docentes orientar mejor tu retroalimentación de proyectos.</div>
                                    </div>

                                    <div class="d-flex justify-content-end">
                                        <button type="submit" class="btn btn-primary fw-semibold px-4" style="background:var(--brand-primary);border:none;">
                                            <i class="fas fa-save me-1"></i> Guardar Cambios
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Tab 2: Seguridad -->
                        <div class="tab-pane fade" id="tab-seguridad">
                            <div class="settings-card p-4 mb-4">
                                <div class="border-bottom pb-3 mb-4">
                                    <h4 class="h5 fw-bold font-heading mb-1 text-dark">Cambio de Contraseña</h4>
                                    <p class="text-muted small mb-0">Protege tu cuenta con una contraseña segura de al menos 6 caracteres.</p>
                                </div>

                                <form action="/configuracion/password" method="POST">
                                    <div class="mb-3" style="max-width: 480px;">
                                        <label for="passwordActual" class="form-label fw-semibold text-dark small">Contraseña Actual <span class="text-danger">*</span></label>
                                        <input type="password" class="form-control" id="passwordActual" name="passwordActual" required placeholder="Ingresa tu clave actual">
                                    </div>

                                    <div class="row g-3 mb-4" style="max-width: 680px;">
                                        <div class="col-md-6">
                                            <label for="passwordNueva" class="form-label fw-semibold text-dark small">Nueva Contraseña <span class="text-danger">*</span></label>
                                            <input type="password" class="form-control" id="passwordNueva" name="passwordNueva" required minlength="8" placeholder="Mínimo 8 caracteres">
                                        </div>
                                        <div class="col-md-6">
                                            <label for="passwordConfirmar" class="form-label fw-semibold text-dark small">Confirmar Nueva Contraseña <span class="text-danger">*</span></label>
                                            <input type="password" class="form-control" id="passwordConfirmar" name="passwordConfirmar" required minlength="8" placeholder="Repite la nueva clave">
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary fw-semibold px-4" style="background:var(--brand-primary);border:none;">
                                        <i class="fas fa-key me-1"></i> Actualizar Contraseña
                                    </button>
                                </form>
                            </div>

                            <div class="settings-card p-4">
                                <h5 class="fw-bold font-heading mb-2 text-dark">Sesión Activa</h5>
                                <p class="text-muted small mb-3">Dispositivo y entorno desde el cual accedes a la plataforma.</p>
                                <div class="p-3 bg-light border rounded-3 d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="fas fa-laptop-code text-primary fs-4"></i>
                                        <div>
                                            <div class="fw-semibold text-dark">Navegador Web Actual</div>
                                            <small class="text-muted font-mono">Sesión iniciada vía Express Session</small>
                                        </div>
                                    </div>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">
                                        <i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i> Conectado
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 3: Notificaciones -->
                        <div class="tab-pane fade" id="tab-notificaciones">
                            <div class="settings-card p-4">
                                <div class="border-bottom pb-3 mb-4">
                                    <h4 class="h5 fw-bold font-heading mb-1 text-dark">Preferencias de Notificaciones</h4>
                                    <p class="text-muted small mb-0">Configura los avisos automáticos sobre tus entregas y novedades académicas.</p>
                                </div>

                                <div class="list-group list-group-flush border-0">
                                    <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center bg-transparent border-bottom">
                                        <div>
                                            <div class="fw-semibold text-dark">Retroalimentación de Proyectos</div>
                                            <small class="text-muted">Aviso cuando un docente califique o comente tu entrega práctica.</small>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="notifProyectos" checked>
                                        </div>
                                    </div>
                                    <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center bg-transparent border-bottom">
                                        <div>
                                            <div class="fw-semibold text-dark">Nuevos Cursos y Actualizaciones</div>
                                            <small class="text-muted">Información sobre nuevas tecnologías agregadas a Eduplat.</small>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="notifCursos" checked>
                                        </div>
                                    </div>
                                    <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center bg-transparent">
                                        <div>
                                            <div class="fw-semibold text-dark">Comunidad y Foros de Consulta</div>
                                            <small class="text-muted">Notificaciones cuando otros estudiantes respondan a hilos de debate.</small>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="notifComunidad">
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                                    <button type="button" class="btn btn-outline-primary fw-semibold btn-sm" onclick="alert('Preferencias de notificación guardadas en tu perfil.')">
                                        Guardar Preferencias
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 4: Zona de Peligro -->
                        <div class="tab-pane fade" id="tab-peligro">
                            <div class="settings-card p-4">
                                <div class="border-bottom pb-3 mb-4">
                                    <h4 class="h5 fw-bold font-heading mb-1 text-danger">
                                        <i class="fas fa-exclamation-triangle me-1"></i> Zona de Peligro
                                    </h4>
                                    <p class="text-muted small mb-0">Acciones críticas e irreversibles vinculadas a tu cuenta en Eduplat.</p>
                                </div>

                                <div class="danger-zone-box">
                                    <h6 class="fw-bold text-danger mb-2">Eliminar Cuenta Permanentemente</h6>
                                    <p class="small text-muted mb-3">
                                        Al eliminar tu cuenta, se borrarán todos tus registros académicos, bitácoras de avance, proyectos prácticos y certificados emitidos. Esta acción no se puede deshacer.
                                    </p>
                                    <button type="button" class="btn btn-danger btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalEliminarCuenta">
                                        <i class="fas fa-trash-alt me-1"></i> Eliminar mi cuenta
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Modal Confirmar Eliminación -->
    <div class="modal fade" id="modalEliminarCuenta" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger bg-opacity-10 border-bottom border-danger-subtle">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Eliminación
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div style="width: 56px; height: 56px; background: #fee2e2; color: #ef4444; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 1rem;">
                        <i class="fas fa-user-slash"></i>
                    </div>
                    <p class="text-dark mb-1 fw-semibold">¿Seguro que deseas eliminar tu cuenta?</p>
                    <p class="small text-muted mb-0">
                        Esta acción es definitiva. Se destruirá tu sesión y se purgarán tus datos de MongoDB.
                    </p>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <form action="/configuracion/eliminar-cuenta" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger fw-semibold">
                            Sí, Eliminar Cuenta
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Oficial Technical Studio -->
    <footer class="edu-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="edu-brand mb-2">
                        <div class="edu-brand-mark" style="width:26px; height:26px; font-size:0.75rem;">
                            <i class="fas fa-terminal"></i>
                        </div>
                        <span>Eduplat</span>
                    </div>
                    <p class="small text-muted" style="max-width: 320px;">
                        Plataforma de formación técnica orientada a estándares de la industria y buenas prácticas de desarrollo.
                    </p>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Plataforma</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/">Inicio</a></li>
                        <li class="mb-2"><a href="/temas">Cursos</a></li>
                        <li class="mb-2"><a href="/contacto">Soporte</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Tecnologías</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/curso/javascript">JavaScript</a></li>
                        <li class="mb-2"><a href="/curso/typescript">TypeScript</a></li>
                        <li class="mb-2"><a href="/curso/python">Python</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Contacto</h6>
                    <p class="small text-muted mb-1 font-mono">contacto@eduplat.org</p>
                </div>
            </div>
            <div class="pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                <span>&copy; <%= new Date().getFullYear() %> Eduplat. Todos los derechos reservados.</span>
                <span class="font-mono" style="font-size: 0.75rem;">v1.0 • Technical Studio</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
</body>

</html>
