<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= datosContacto.titulo %> — Eduplat</title>
    <meta name="description" content="Ponte en contacto con el equipo de soporte y admisiones de Eduplat.">
    <link rel="canonical" href="http://localhost:3000/contacto">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="http://localhost:3000/contacto">
    <meta property="og:title" content="<%= datosContacto.titulo %> — Eduplat">
    <meta property="og:description" content="Ponte en contacto con el equipo de soporte y admisiones de Eduplat.">
    <meta property="og:image" content="/favicon.svg">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= datosContacto.titulo %> — Eduplat">
    <meta name="twitter:description" content="Ponte en contacto con el equipo de soporte y admisiones de Eduplat.">

    <link rel="manifest" href="/manifest.webmanifest">

    <!-- Preconnect & Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CDN con SRI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <!-- Font Awesome 6 CDN con SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- CSS personalizado con Design System Technical Studio -->
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
</head>
<body>
    <!-- Navbar global -->
    <%- include('partials/navbar') %>

    <main id="main-content">
        <!-- Header Section (Technical Studio Minimalist Banner) -->
        <section class="py-5 bg-white border-bottom" style="border-color: var(--border-subtle) !important;">
            <div class="container py-2">
                <div style="max-width: 680px;">
                    <span class="course-meta-badge mb-2 d-inline-block">Centro de Asistencia</span>
                    <h1 class="mb-2" style="font-size: clamp(2rem, 3.5vw, 2.5rem);"><%= datosContacto.titulo %></h1>
                    <p class="text-secondary lead mb-0" style="font-size: 1.05rem;">
                        <%= datosContacto.descripcion %>
                    </p>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section class="py-5" style="background-color: var(--canvas-bg);">
            <div class="container">
                <% if(typeof mensaje_exito !== 'undefined' && mensaje_exito) { %>
                    <div class="alert alert-success alert-dismissible fade show mb-4 d-flex align-items-center gap-2 rounded-2" role="alert">
                        <i class="fas fa-check-circle"></i>
                        <span><%= mensaje_exito %></span>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <div class="row g-4">
                    <!-- Formulario de Contacto -->
                    <div class="col-lg-7">
                        <div class="p-4 p-md-5 bg-white border rounded-4 shadow-sm" style="border-color: var(--border-subtle) !important;">
                            <h2 class="h4 mb-1">Envíanos un mensaje</h2>
                            <p class="text-secondary small mb-4">Nuestro equipo técnico responde en un plazo máximo de 24 horas hábiles.</p>
                            
                            <form action="/contacto" method="POST">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label for="nombre" class="form-label small fw-semibold text-dark">Nombre Completo</label>
                                        <input 
                                            type="text" 
                                            class="form-control" 
                                            id="nombre" 
                                            name="nombre"
                                            placeholder="Tu nombre"
                                            required
                                            style="border-color: var(--border-subtle); border-radius: var(--radius-sm);"
                                        >
                                    </div>
                                    <div class="col-md-6">
                                        <label for="email" class="form-label small fw-semibold text-dark">Correo Electrónico</label>
                                        <input 
                                            type="email" 
                                            class="form-control" 
                                            id="email" 
                                            name="email"
                                            placeholder="tu@email.com"
                                            required
                                            style="border-color: var(--border-subtle); border-radius: var(--radius-sm);"
                                        >
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="asunto" class="form-label small fw-semibold text-dark">Asunto</label>
                                    <input 
                                        type="text" 
                                        class="form-control" 
                                        id="asunto" 
                                        name="asunto"
                                        placeholder="¿En qué podemos ayudarte?"
                                        required
                                        style="border-color: var(--border-subtle); border-radius: var(--radius-sm);"
                                    >
                                </div>

                                <div class="mb-4">
                                    <label for="mensaje" class="form-label small fw-semibold text-dark">Mensaje</label>
                                    <textarea 
                                        class="form-control" 
                                        id="mensaje" 
                                        name="mensaje"
                                        rows="5"
                                        placeholder="Describe tu consulta con el mayor detalle posible..."
                                        required
                                        style="border-color: var(--border-subtle); border-radius: var(--radius-sm);"
                                    ></textarea>
                                </div>

                                <button type="submit" class="btn-edu-primary py-2 px-4">
                                    <span>Enviar Mensaje</span>
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Información de Contacto -->
                    <div class="col-lg-5">
                        <div class="p-4 p-md-5 bg-white border rounded-4 shadow-sm h-100" style="border-color: var(--border-subtle) !important;">
                            <h2 class="h4 mb-1">Información de Contacto</h2>
                            <p class="text-secondary small mb-4">Canales directos de soporte y comunidad técnica.</p>

                            <div class="d-flex align-items-start gap-3 mb-4">
                                <div class="tech-icon-container flex-shrink-0" style="width:40px;height:40px;">
                                    <i class="far fa-envelope text-dark"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 text-dark fw-bold">Correo Electrónico</h6>
                                    <p class="mb-0 font-mono small text-secondary"><%= datosContacto.email %></p>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3 mb-4">
                                <div class="tech-icon-container flex-shrink-0" style="width:40px;height:40px;">
                                    <i class="fas fa-phone-alt text-dark"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 text-dark fw-bold">Línea Telefónica</h6>
                                    <p class="mb-0 font-mono small text-secondary"><%= datosContacto.telefono %></p>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3 mb-4">
                                <div class="tech-icon-container flex-shrink-0" style="width:40px;height:40px;">
                                    <i class="fas fa-map-marker-alt text-dark"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 text-dark fw-bold">Ubicación</h6>
                                    <p class="mb-0 small text-secondary"><%= datosContacto.ubicacion %></p>
                                </div>
                            </div>

                            <hr style="border-color: var(--border-subtle); margin: 2rem 0;">

                            <h6 class="text-dark fw-bold mb-2">Comunidad y Repositorios</h6>
                            <p class="small text-secondary mb-3">Sigue los proyectos de código abierto y contribuciones de estudiantes.</p>
                            <div class="d-flex gap-3 text-secondary">
                                <a href="https://github.com" target="_blank" rel="noopener" class="text-dark"><i class="fab fa-github fa-lg"></i></a>
                                <a href="https://linkedin.com" target="_blank" rel="noopener" class="text-dark"><i class="fab fa-linkedin fa-lg"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="edu-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="edu-brand mb-2">
                        <div class="edu-brand-mark" style="width:26px; height:26px; font-size:0.75rem;">
                            <i class="fas fa-terminal"></i>
                        </div>
                        <span>Eduplat</span>
                    </div>
                    <p class="small text-muted" style="max-width: 320px;">
                        Plataforma de formación técnica orientada a estándares de la industria y buenas prácticas de desarrollo.
                    </p>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Plataforma</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/">Inicio</a></li>
                        <li class="mb-2"><a href="/temas">Cursos</a></li>
                        <li class="mb-2"><a href="/contacto">Soporte</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Tecnologías</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/curso/javascript">JavaScript</a></li>
                        <li class="mb-2"><a href="/curso/typescript">TypeScript</a></li>
                        <li class="mb-2"><a href="/curso/python">Python</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Contacto</h6>
                    <p class="small text-muted mb-1 font-mono">contacto@eduplat.org</p>
                </div>
            </div>
            <div class="pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                <span>&copy; <%= new Date().getFullYear() %> Eduplat. Todos los derechos reservados.</span>
                <span class="font-mono" style="font-size: 0.75rem;">v1.0 • Technical Studio</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous" defer></script>
    <%- include('partials/sw-register') %>
</body>
</html>
