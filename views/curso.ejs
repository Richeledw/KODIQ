<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= datosCurso.titulo %> — Eduplat</title>
    <meta name="description" content="<%= datosCurso.descripcion %>">
    <link rel="canonical" href="http://localhost:3000/curso/<%= datosCurso.id %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="http://localhost:3000/curso/<%= datosCurso.id %>">
    <meta property="og:title" content="<%= datosCurso.titulo %> — Eduplat">
    <meta property="og:description" content="<%= datosCurso.descripcion %>">
    <meta property="og:image" content="<%= datosCurso.icono || '/favicon.svg' %>">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= datosCurso.titulo %> — Eduplat">
    <meta name="twitter:description" content="<%= datosCurso.descripcion %>">
    <meta name="twitter:image" content="<%= datosCurso.icono || '/favicon.svg' %>">

    <!-- PWA Web Manifest -->
    <link rel="manifest" href="/manifest.webmanifest">

    <!-- JSON-LD Structured Data: Course -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": <%- JSON.stringify(datosCurso.titulo) %>,
      "description": <%- JSON.stringify(datosCurso.descripcion) %>,
      "provider": {
        "@type": "Organization",
        "name": "Eduplat",
        "sameAs": "http://localhost:3000"
      },
      "educationalLevel": "<%= datosCurso.nivel || 'Beginner' %>",
      "timeRequired": "<%= datosCurso.duracion || '10 horas' %>"
    }
    </script>

    <!-- Bootstrap 5 CDN con SRI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <!-- Font Awesome 6 CDN con SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- CSS del Sistema de Diseño Technical Studio -->
    <link rel="stylesheet" href="/css/styles.css">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">

    <style>
        body {
            font-family: var(--font-body);
            background-color: var(--canvas-bg);
            color: var(--brand-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        /* ── Header del Curso ── */
        .course-hero {
            background: #FFFFFF;
            border-bottom: 1px solid var(--border-subtle);
            padding: 3.5rem 0 3rem;
        }

        .course-hero-icon {
            width: 84px;
            height: 84px;
            background: #FFFFFF;
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-sm);
            flex-shrink: 0;
        }

        .course-hero-icon img {
            width: 48px;
            height: 48px;
            object-fit: contain;
        }

        /* ── Tarjetas de Contenido ── */
        .content-card-pro {
            background: #FFFFFF;
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-xs);
        }

        .content-card-pro h3,
        .content-card-pro h4 {
            font-family: var(--font-heading);
            font-weight: 700;
            color: var(--brand-dark);
            margin-bottom: 1.25rem;
        }

        /* ── Sticky Sidebar Card ── */
        .sidebar-sticky-card {
            background: #FFFFFF;
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            padding: 2rem;
            box-shadow: var(--shadow-md);
            position: sticky;
            top: 2rem;
        }

        /* ── Accordion Temario ── */
        .accordion-item {
            border: 1px solid var(--border-subtle);
            border-radius: 10px !important;
            margin-bottom: 0.75rem;
            overflow: hidden;
            background: #FFFFFF;
        }

        .accordion-button {
            font-family: var(--font-heading);
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--brand-dark);
            background: #FFFFFF;
            padding: 1.1rem 1.25rem;
            box-shadow: none !important;
        }

        .accordion-button:not(.collapsed) {
            background: #F4F4F5;
            color: var(--brand-dark);
        }

        .accordion-button::after {
            filter: grayscale(1);
        }

        /* ── Botones ── */
        .btn-brand-dark {
            background: var(--brand-dark);
            color: #FFFFFF;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-brand-dark:hover {
            background: #27272A;
            color: #FFFFFF;
            transform: translateY(-1px);
        }
    </style>
</head>

<body>
    <!-- Navbar Oficial -->
    <%- include('partials/navbar') %>

    <main id="main-content">
        <!-- Hero Header Espacioso y Limpio -->
        <section class="course-hero">
            <div class="container">
                <!-- Breadcrumbs -->
                <nav class="small font-mono text-muted mb-3">
                    <a href="/" class="text-decoration-none text-muted">Inicio</a>
                    <span class="mx-2">/</span>
                    <a href="/temas" class="text-decoration-none text-muted">Cursos</a>
                    <span class="mx-2">/</span>
                    <span class="text-dark fw-semibold"><%= datosCurso.titulo %></span>
                </nav>

                <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">
                    <div class="course-hero-icon">
                        <img src="<%= datosCurso.icono %>" alt="<%= datosCurso.titulo %>" onerror="this.src='/img/html5.svg'">
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="badge bg-light text-dark border font-mono px-2 py-1" style="font-size: 0.75rem;">
                                <%= (datosCurso.categoria || 'TECNOLOGÍA').toUpperCase() %>
                            </span>
                            <span class="badge bg-light text-secondary border font-mono px-2 py-1" style="font-size: 0.75rem;">
                                NIVEL: <%= (datosCurso.nivel || 'Beginner').toUpperCase() %>
                            </span>
                            <span class="badge bg-light text-secondary border font-mono px-2 py-1" style="font-size: 0.75rem;">
                                <%= datosCurso.duracion || '10 horas' %>
                            </span>
                        </div>
                        <h1 class="h2 fw-bold font-heading mb-2 text-dark" style="font-size: clamp(1.8rem, 3vw, 2.4rem);">
                            <%= datosCurso.titulo %>
                        </h1>
                        <p class="text-secondary mb-3 lead" style="font-size: 1.05rem; max-width: 820px;">
                            <%= datosCurso.descripcion %>
                        </p>
                        <div class="d-flex align-items-center gap-3 small font-mono text-muted">
                            <span><i class="fas fa-star text-warning me-1"></i><%= datosCurso.calificacion || '4.9' %> (<%= datosCurso.resenas || 180 %> valoraciones)</span>
                            <span>•</span>
                            <span><i class="fas fa-user-check me-1"></i>Certificado Oficial Incluido</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contenedor Principal (Grid Amplio y Balanceado) -->
        <div class="container py-5">
            <div class="row g-5">
                <!-- Columna Izquierda: Información, Temario y Requisitos (70% aprox) -->
                <div class="col-lg-8">
                    <!-- Sobre el Curso -->
                    <div class="content-card-pro">
                        <h4><i class="fas fa-info-circle me-2 text-secondary"></i>Sobre este Programa</h4>
                        <div class="text-secondary lh-lg" style="font-size: 1rem;">
                            <%= datosCurso.descripcionLarga || datosCurso.descripcion %>
                            <p class="mt-3 mb-0">
                                Este curso proporciona las bases teóricas y la ejercitación práctica para dominar <strong><%= datosCurso.titulo %></strong>. Cada lección está diseñada con código reproducible, terminal de pruebas interactiva y un proyecto práctico integrador para consolidar tus habilidades.
                            </p>
                        </div>
                    </div>

                    <!-- Temario Dinámico del Curso -->
                    <div class="content-card-pro">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="mb-0"><i class="fas fa-list-check me-2 text-secondary"></i>Plan de Estudios</h4>
                            <span class="badge bg-light text-dark font-mono border">
                                <%= (datosCurso.modulos || []).length %> Módulos • <%= (datosCurso.modulos || []).reduce((acc, m) => acc + ((m.lecciones || []).length), 0) %> Lecciones
                            </span>
                        </div>

                        <% if (datosCurso.modulos && datosCurso.modulos.length > 0) { %>
                            <div class="accordion" id="accordionTemarioCurso">
                                <% datosCurso.modulos.forEach((modulo, mIdx) => { %>
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingMod<%= mIdx %>">
                                            <button class="accordion-button <%= mIdx > 0 ? 'collapsed' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMod<%= mIdx %>">
                                                <span class="badge bg-light text-dark border font-mono me-3">#0<%= mIdx + 1 %></span>
                                                <span class="flex-grow-1"><%= modulo.titulo %></span>
                                                <span class="text-muted small me-2 font-mono"><%= (modulo.lecciones || []).length %> lecciones</span>
                                            </button>
                                        </h2>
                                        <div id="collapseMod<%= mIdx %>" class="accordion-collapse collapse <%= mIdx === 0 ? 'show' : '' %>" data-bs-parent="#accordionTemarioCurso">
                                            <div class="accordion-body p-0">
                                                <ul class="list-group list-group-flush">
                                                    <% if (modulo.lecciones && modulo.lecciones.length > 0) { %>
                                                        <% modulo.lecciones.forEach((lec) => { %>
                                                            <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center bg-transparent border-bottom">
                                                                <div class="d-flex align-items-center gap-3">
                                                                    <i class="far fa-play-circle text-muted"></i>
                                                                    <div>
                                                                        <span class="fw-medium text-dark"><%= lec.titulo %></span>
                                                                        <% if (lec.explicacionDetallada) { %>
                                                                            <p class="small text-muted mb-0"><%= lec.explicacionDetallada.substring(0, 90) %>...</p>
                                                                        <% } %>
                                                                    </div>
                                                                </div>
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <span class="badge bg-light text-muted font-mono"><%= lec.duracion || '15 min' %></span>
                                                                    <% if (datosCurso.estaInscrito) { %>
                                                                        <a href="/curso/<%= datosCurso.id %>/aula" class="btn btn-sm btn-outline-dark py-0 px-2" style="font-size: 0.75rem;">Ver</a>
                                                                    <% } else { %>
                                                                        <i class="fas fa-lock text-muted" style="font-size: 0.75rem;"></i>
                                                                    <% } %>
                                                                </div>
                                                            </li>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <li class="list-group-item px-4 py-2 text-muted small">Sin lecciones registradas aún.</li>
                                                    <% } %>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <div class="p-4 text-center text-muted">
                                <i class="fas fa-book-open fa-2x mb-2 text-secondary opacity-50"></i>
                                <p class="mb-0">El temario de este curso está en preparación.</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Proyecto Práctico del Curso -->
                    <div class="content-card-pro">
                        <h4><i class="fas fa-laptop-code me-2 text-secondary"></i>Proyecto Práctico de Certificación</h4>
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <h5 class="fw-bold text-dark mb-1 font-heading">
                                <%= datosCurso.proyectoConsigna?.titulo || 'Proyecto Integrador del Curso' %>
                            </h5>
                            <p class="text-secondary small mb-3">
                                <%= datosCurso.proyectoConsigna?.descripcion || 'Aplica los conceptos impartidos en el curso construyendo una solución práctica y funcional evaluada por el equipo docente.' %>
                            </p>
                            <h6 class="small fw-bold text-dark font-mono mb-2">REQUISITOS DEL ENTREGABLE:</h6>
                            <ul class="small text-secondary mb-0 ps-3">
                                <% if (datosCurso.proyectoConsigna?.requisitos && datosCurso.proyectoConsigna.requisitos.length > 0) { %>
                                    <% datosCurso.proyectoConsigna.requisitos.forEach(r => { %>
                                        <li class="mb-1"><%= r %></li>
                                    <% }) %>
                                <% } else { %>
                                    <li class="mb-1">Estructura limpia y ordenada de archivos</li>
                                    <li class="mb-1">Repositorio de código público en GitHub</li>
                                    <li class="mb-1">Despliegue funcional en vivo</li>
                                <% } %>
                            </ul>
                        </div>
                    </div>

                    <!-- Requisitos Previos -->
                    <div class="content-card-pro mb-0">
                        <h4><i class="fas fa-clipboard-check me-2 text-secondary"></i>Requisitos Previos</h4>
                        <ul class="list-unstyled mb-0">
                            <li class="d-flex align-items-center gap-2 mb-2 text-secondary">
                                <i class="fas fa-check text-dark small"></i> Computadora con conexión a internet y navegador moderno.
                            </li>
                            <li class="d-flex align-items-center gap-2 mb-2 text-secondary">
                                <i class="fas fa-check text-dark small"></i> Editor de código (VS Code recomendado) o uso de la terminal integrada de Eduplat.
                            </li>
                            <li class="d-flex align-items-center gap-2 text-secondary">
                                <i class="fas fa-check text-dark small"></i> Disposición para practicar y construir proyectos reales.
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Columna Derecha: Sticky Action Box (30% aprox) -->
                <div class="col-lg-4">
                    <div class="sidebar-sticky-card">
                        <% if(datosCurso.estaInscrito) { %>
                            <div class="text-center mb-4">
                                <span class="badge bg-light text-dark border font-mono px-3 py-2 w-100 mb-3 fw-semibold">
                                    <i class="fas fa-check-circle text-success me-1"></i> Ya estás inscrito
                                </span>
                                <div class="d-flex justify-content-between align-items-center small text-muted font-mono mb-2">
                                    <span>Progreso actual:</span>
                                    <strong class="text-dark"><%= datosCurso.progresoInscripcion %>%</strong>
                                </div>
                                <div class="progress mb-4" style="height: 6px; background-color: #F4F4F5;">
                                    <div class="progress-bar bg-dark" style="width: <%= datosCurso.progresoInscripcion %>%;"></div>
                                </div>
                                <a href="/curso/<%= datosCurso.id %>/aula" class="btn btn-brand-dark w-100 py-3 font-heading fs-6 shadow-sm">
                                    <i class="fas fa-play me-2"></i> Continuar en el Aula
                                </a>
                            </div>
                        <% } else { %>
                            <div class="mb-4">
                                <div class="h3 fw-bold font-heading mb-1 text-dark">Acceso Completo</div>
                                <p class="text-muted small mb-4">Inscripción libre para miembros de Eduplat.</p>
                                
                                <% if(locals.isAuthenticated) { %>
                                    <form action="/curso/<%= datosCurso.id %>/inscribir" method="POST">
                                        <button type="submit" class="btn btn-brand-dark w-100 py-3 font-heading fs-6 shadow-sm">
                                            <i class="fas fa-user-plus me-2"></i> Inscribirme al Curso
                                        </button>
                                    </form>
                                <% } else { %>
                                    <a href="/login?redirect=/curso/<%= datosCurso.id %>" class="btn btn-brand-dark w-100 py-3 font-heading fs-6 shadow-sm text-center d-block">
                                        <i class="fas fa-sign-in-alt me-2"></i> Iniciar Sesión para Inscribirte
                                    </a>
                                <% } %>
                            </div>
                        <% } %>

                        <div class="pt-3 border-top">
                            <h6 class="small font-mono fw-bold text-dark mb-3">ESTE PROGRAMA INCLUYE:</h6>
                            <ul class="list-unstyled small text-secondary mb-0">
                                <li class="mb-2 d-flex align-items-center gap-2">
                                    <i class="far fa-play-circle text-muted"></i> Lecciones grabadas y explicaciones en texto
                                </li>
                                <li class="mb-2 d-flex align-items-center gap-2">
                                    <i class="fas fa-terminal text-muted"></i> Terminal y ejercicios interactivos por módulo
                                </li>
                                <li class="mb-2 d-flex align-items-center gap-2">
                                    <i class="fas fa-tasks text-muted"></i> Quizzes con retroalimentación inmediata
                                </li>
                                <li class="mb-2 d-flex align-items-center gap-2">
                                    <i class="fas fa-comment-dots text-muted"></i> Evaluación y feedback del proyecto por docentes
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fas fa-certificate text-muted"></i> Certificado digital verificable oficial
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer Oficial Technical Studio -->
    <footer class="edu-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="edu-brand mb-2">
                        <div class="edu-brand-mark" style="width:26px; height:26px; font-size:0.75rem;">
                            <i class="fas fa-terminal"></i>
                        </div>
                        <span>Eduplat</span>
                    </div>
                    <p class="small text-muted" style="max-width: 320px;">
                        Plataforma de formación técnica orientada a estándares de la industria y buenas prácticas de desarrollo.
                    </p>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Plataforma</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/">Inicio</a></li>
                        <li class="mb-2"><a href="/temas">Cursos</a></li>
                        <li class="mb-2"><a href="/contacto">Soporte</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Tecnologías</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/curso/javascript">JavaScript</a></li>
                        <li class="mb-2"><a href="/curso/typescript">TypeScript</a></li>
                        <li class="mb-2"><a href="/curso/python">Python</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Contacto</h6>
                    <p class="small text-muted mb-1 font-mono">contacto@eduplat.org</p>
                </div>
            </div>
            <div class="pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                <span>&copy; <%= new Date().getFullYear() %> Eduplat. Todos los derechos reservados.</span>
                <span class="font-mono" style="font-size: 0.75rem;">v1.0 • Technical Studio</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS con SRI y defer -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous" defer></script>
    <%- include('partials/sw-register') %>
</body>
</html>
