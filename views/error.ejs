<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error <%= typeof status !== 'undefined' ? status : '404' %> - Eduplat</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS personalizado -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        body {
            font-family: var(--font-body);
            background-color: var(--canvas-bg);
            color: var(--brand-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 1rem;
        }

        .error-card {
            background: #FFFFFF;
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            padding: 3.5rem 2.5rem;
            text-align: center;
            max-width: 540px;
            width: 100%;
        }

        .error-code {
            font-family: var(--font-mono);
            font-size: 5rem;
            font-weight: 700;
            line-height: 1;
            color: var(--brand-primary);
            letter-spacing: -2px;
            margin-bottom: 0.5rem;
        }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
</head>

<body>
    <!-- Navbar Oficial Sincronizado con SSR y CSR -->
    <%- include('partials/navbar') %>

    <main>
        <div class="error-card">
            <!-- Badge de estado -->
            <div class="mb-3">
                <span class="badge bg-light text-secondary border font-mono px-3 py-2" style="font-size: 0.8rem;">
                    <i class="fas fa-exclamation-triangle text-warning me-1"></i> CÓDIGO HTTP <%= typeof status !== 'undefined' ? status : '404' %>
                </span>
            </div>

            <!-- Código de error -->
            <div class="error-code"><%= typeof status !== 'undefined' ? status : '404' %></div>

            <!-- Título y descripción -->
            <h1 class="h4 fw-bold font-heading mb-2 text-dark">
                <%= typeof mensaje !== 'undefined' && mensaje ? mensaje : 'Página no encontrada' %>
            </h1>

            <p class="text-secondary small mb-4 mx-auto" style="max-width: 420px;">
                <%= typeof descripcion !== 'undefined' && descripcion 
                    ? descripcion 
                    : 'La ruta solicitada no existe, ha sido movida o requiere privilegios de sesión diferentes.' %>
            </p>

            <!-- Acciones -->
            <div class="d-flex gap-2 justify-content-center flex-wrap pt-2">
                <a href="/" class="btn btn-primary fw-semibold px-4 py-2" style="background:var(--brand-primary);border:none;">
                    <i class="fas fa-home me-2"></i> Ir al Inicio
                </a>
                <a href="/temas" class="btn btn-outline-secondary fw-medium px-4 py-2">
                    <i class="fas fa-book-open me-2"></i> Catálogo de Cursos
                </a>
            </div>
        </div>
    </main>

    <!-- Footer Oficial Technical Studio -->
    <footer class="edu-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="edu-brand mb-2">
                        <div class="edu-brand-mark" style="width:26px; height:26px; font-size:0.75rem;">
                            <i class="fas fa-terminal"></i>
                        </div>
                        <span>Eduplat</span>
                    </div>
                    <p class="small text-muted" style="max-width: 320px;">
                        Plataforma de formación técnica orientada a estándares de la industria y buenas prácticas de desarrollo.
                    </p>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Plataforma</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/">Inicio</a></li>
                        <li class="mb-2"><a href="/temas">Cursos</a></li>
                        <li class="mb-2"><a href="/contacto">Soporte</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Tecnologías</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/curso/javascript">JavaScript</a></li>
                        <li class="mb-2"><a href="/curso/typescript">TypeScript</a></li>
                        <li class="mb-2"><a href="/curso/python">Python</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Contacto</h6>
                    <p class="small text-muted mb-1 font-mono">contacto@eduplat.org</p>
                </div>
            </div>
            <div class="pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                <span>&copy; <%= new Date().getFullYear() %> Eduplat. Todos los derechos reservados.</span>
                <span class="font-mono" style="font-size: 0.75rem;">v1.0 • Technical Studio</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/navbar-auth.js"></script>
</body>

</html>
