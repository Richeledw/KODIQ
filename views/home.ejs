<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= datosHome.titulo %> — Eduplat</title>
    <meta name="description" content="Aprende desarrollo web y backend con cursos prácticos y fundamentados en Eduplat.">

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- CSS personalizado con Design System Technical Studio -->
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
</head>

<body>
    <!-- Header / Navbar global -->
    <%- include('partials/navbar') %>

    <main>
        <!-- Hero Section (Technical Studio Edition) -->
        <section class="hero-technical">
            <div class="container">
                <div class="hero-technical-content">
                    <div class="hero-badge-live">
                        <span class="hero-badge-dot"></span>
                        <span>Plataforma de formación técnica</span>
                    </div>
                    <h1><%= datosHome.titulo %></h1>
                    <p class="lead">
                        <%= datosHome.subtitulo %>
                    </p>
                    <div class="d-flex flex-wrap align-items-center justify-content-center gap-3 mb-5">
                        <a href="/temas" class="btn-edu-primary">
                            <span>Explorar Catálogo</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                        <!-- Botón para Invitado -->
                        <a href="/registro" class="btn-edu-secondary <%= locals.user ? 'd-none' : '' %>" data-auth="guest" <%= locals.user ? 'style="display:none !important;"' : '' %>>
                            <i class="fas fa-user-plus text-muted"></i>
                            <span>Crear Cuenta Gratis</span>
                        </a>
                        <!-- Botón para Usuario Autenticado -->
                        <a href="/panel" class="btn-edu-secondary link-mi-panel <%= locals.user ? '' : 'd-none' %>" data-auth="user" <%= locals.user ? '' : 'style="display:none !important;"' %>>
                            <i class="fas fa-laptop-code text-muted link-mi-panel-icon"></i>
                            <span class="link-mi-panel-text">Ir a Mi Panel</span>
                        </a>
                    </div>

                    <!-- Terminal / Code Sandbox Mockup (Auténtico artefacto técnico) -->
                    <div class="terminal-window mx-auto" style="max-width: 680px;">
                        <div class="terminal-header">
                            <div class="terminal-dots">
                                <span class="terminal-dot" style="background:#EF4444;"></span>
                                <span class="terminal-dot" style="background:#F59E0B;"></span>
                                <span class="terminal-dot" style="background:#10B981;"></span>
                            </div>
                            <span class="terminal-title">eduplat-workspace — interactive-lesson.ts</span>
                            <span class="terminal-title font-mono" style="font-size:0.7rem;color:#10B981;">● READY</span>
                        </div>
                        <div class="terminal-body text-start">
                            <div style="color: #64748B;">// Aprende con proyectos reales, métricas de progreso y feedback instantáneo</div>
                            <div><span style="color: #F43F5E;">import</span> { <span style="color: #38BDF8;">DeveloperCourse</span>, <span style="color: #38BDF8;">Certification</span> } <span style="color: #F43F5E;">from</span> <span style="color: #A3E635;">'@eduplat/core'</span>;</div>
                            <br>
                            <div><span style="color: #F43F5E;">const</span> <span style="color: #FACC15;">track</span> = <span style="color: #F43F5E;">new</span> <span style="color: #38BDF8;">DeveloperCourse</span>({</div>
                            <div class="ps-3"><span style="color: #94A3B8;">focus:</span> <span style="color: #A3E635;">'Fullstack Web &amp; Systems'</span>,</div>
                            <div class="ps-3"><span style="color: #94A3B8;">methodology:</span> <span style="color: #A3E635;">'Practice-first, production-ready code'</span>,</div>
                            <div class="ps-3"><span style="color: #94A3B8;">certified:</span> <span style="color: #F43F5E;">true</span></div>
                            <div>});</div>
                            <div style="color: #10B981; margin-top: 0.5rem;">✔ 8 rutas formativas disponibles con acceso completo</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Featured Courses Section -->
        <section class="py-5" style="background-color: var(--canvas-bg);">
            <div class="container py-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-4 gap-3">
                    <div>
                        <div class="course-meta-badge mb-2 d-inline-block">Catálogo Curado</div>
                        <h2 class="mb-1" style="font-size: 1.85rem;">Rutas de Aprendizaje</h2>
                        <p class="mb-0 text-secondary" style="font-size: 0.95rem;">Contenido estructurado desde los fundamentos hasta arquitecturas escalables.</p>
                    </div>
                    <a href="/temas" class="btn-edu-secondary">
                        <span>Ver todos los cursos</span>
                        <i class="fas fa-chevron-right" style="font-size: 0.75rem;"></i>
                    </a>
                </div>

                <div class="row g-4">
                    <% 
                    const fallbackCursos = [ 
                        { id: 'html', titulo: 'HTML5 Arquitectura Semántica', descripcion: 'Estructura accesible, metadatos y estándares web modernos.', icono: '/img/html5.svg', nivel: 'Beginner', lecciones: 24, duracion: '8h' },
                        { id: 'css', titulo: 'CSS3 Sistemas de Estilo', descripcion: 'Flexbox, Grid, variables CSS y diseño responsivo robusto.', icono: '/img/css3-alt.svg', nivel: 'Beginner', lecciones: 28, duracion: '10h' }, 
                        { id: 'javascript', titulo: 'JavaScript Moderno ES6+', descripcion: 'Manipulación del DOM, programación asíncrona y patrones de diseño.', icono: '/img/js.svg', nivel: 'Intermedio', lecciones: 32, duracion: '12h' }, 
                        { id: 'typescript', titulo: 'TypeScript para Aplicaciones', descripcion: 'Tipado estático, genéricos e interfaces para código escalable.', icono: '/img/typescript.svg', nivel: 'Intermedio', lecciones: 26, duracion: '9h' },
                        { id: 'python', titulo: 'Python para Backend & Automatización', descripcion: 'Sintaxis limpia, estructuras de datos y desarrollo de APIs.', icono: '/img/python.svg', nivel: 'Beginner', lecciones: 30, duracion: '11h' }, 
                        { id: 'sql', titulo: 'MySQL Modelado & Consultas', descripcion: 'Diseño relacional, normalización y optimización de consultas SQL.', icono: '/img/mysql.svg', nivel: 'Intermedio', lecciones: 22, duracion: '8h' } 
                    ];
                    const listaCursosHome = (locals.datosHome && datosHome.cursosDestacados && datosHome.cursosDestacados.length > 0) ? datosHome.cursosDestacados : fallbackCursos;
                    listaCursosHome.forEach(curso => { %>
                        <div class="col-md-6 col-lg-4">
                            <a href="/curso/<%= curso.id %>" class="course-card-pro">
                                <div class="course-card-top">
                                    <div class="tech-icon-container">
                                        <img src="<%= curso.icono %>" alt="<%= curso.titulo %>">
                                    </div>
                                    <span class="course-meta-badge"><%= curso.nivel %></span>
                                </div>
                                <div class="course-card-body">
                                    <h3 class="course-card-title"><%= curso.titulo %></h3>
                                    <p class="course-card-desc"><%= curso.descripcion || curso.desc %></p>
                                    <div class="course-card-footer">
                                        <span class="course-stat">
                                            <i class="far fa-play-circle text-muted"></i> <%= curso.lecciones %> lecciones
                                        </span>
                                        <span class="course-stat">
                                            <i class="far fa-clock text-muted"></i> <%= curso.duracion %>
                                        </span>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- CTA Section (High-Craft Technical Obsidian Card) -->
        <section class="py-5" style="background-color: #FFFFFF; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
            <div class="container py-3">
                <div class="p-4 p-md-5 rounded-4 text-white text-center position-relative overflow-hidden" style="background: #090D16; border: 1px solid #1E293B;">
                    <div style="max-width: 600px; margin: 0 auto; position: relative; z-index: 1;">
                        <span class="course-meta-badge mb-3 d-inline-block" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: #E2E8F0;">
                            Inicia hoy
                        </span>
                        <h2 class="text-white mb-3" style="font-size: clamp(1.8rem, 3vw, 2.3rem);">¿Listo para dominar tu stack técnico?</h2>
                        <p class="text-secondary mb-4" style="color: #94A3B8 !important; font-size: 1.05rem;">
                            Acceso libre a todos los módulos teóricos y prácticos. Sin tarjetas de crédito ni suscripciones opacas.
                        </p>
                        <!-- CTAs para Invitado -->
                        <div class="d-flex flex-wrap justify-content-center gap-3 <%= locals.user ? 'd-none' : '' %>" data-auth="guest" <%= locals.user ? 'style="display:none !important;"' : '' %>>
                            <a href="/registro" class="btn-edu-accent px-4 py-2">
                                <span>Crear Cuenta Gratuita</span>
                                <i class="fas fa-arrow-right"></i>
                            </a>
                            <a href="/temas" class="btn-edu-secondary px-4 py-2" style="background: transparent; color: #FFFFFF !important; border-color: #334155;">
                                <span>Ver Temario Completo</span>
                            </a>
                        </div>
                        <!-- CTAs para Usuario Autenticado -->
                        <div class="d-flex flex-wrap justify-content-center gap-3 <%= locals.user ? '' : 'd-none' %>" data-auth="user" <%= locals.user ? '' : 'style="display:none !important;"' %>>
                            <a href="/panel" class="btn-edu-accent link-mi-panel px-4 py-2">
                                <span class="link-mi-panel-text">Ir a Mi Panel</span>
                                <i class="fas fa-arrow-right"></i>
                            </a>
                            <a href="/temas" class="btn-edu-secondary px-4 py-2" style="background: transparent; color: #FFFFFF !important; border-color: #334155;">
                                <span>Explorar Todos los Cursos</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer (Technical Studio Edition) -->
    <footer class="edu-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="edu-brand mb-2">
                        <div class="edu-brand-mark" style="width:26px; height:26px; font-size:0.75rem;">
                            <i class="fas fa-terminal"></i>
                        </div>
                        <span>Eduplat</span>
                    </div>
                    <p class="small text-muted" style="max-width: 320px;">
                        Plataforma de formación técnica orientada a estándares de la industria, buenas prácticas de desarrollo y arquitectura de software.
                    </p>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Plataforma</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/">Inicio</a></li>
                        <li class="mb-2"><a href="/temas">Cursos</a></li>
                        <li class="mb-2"><a href="/contacto">Soporte</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Tecnologías</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/curso/javascript">JavaScript</a></li>
                        <li class="mb-2"><a href="/curso/typescript">TypeScript</a></li>
                        <li class="mb-2"><a href="/curso/python">Python</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Contacto</h6>
                    <p class="small text-muted mb-1 font-mono">contacto@eduplat.org</p>
                    <div class="d-flex gap-3 mt-3 text-secondary">
                        <a href="https://github.com" target="_blank" rel="noopener"><i class="fab fa-github fa-lg"></i></a>
                        <a href="https://linkedin.com" target="_blank" rel="noopener"><i class="fab fa-linkedin fa-lg"></i></a>
                    </div>
                </div>
            </div>
            <div class="pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                <span>&copy; <%= new Date().getFullYear() %> Eduplat. Construido para el aprendizaje técnico continuo.</span>
                <span class="font-mono" style="font-size: 0.75rem;">v1.0 • Technical Studio</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('partials/sw-register') %>
</body>

</html>
