<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= datosLogin.titulo %> — Eduplat</title>
    <meta name="description" content="Inicia sesión en Eduplat y accede a tus cursos y progreso de aprendizaje.">
    <link rel="canonical" href="http://localhost:3000/login">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="http://localhost:3000/login">
    <meta property="og:title" content="<%= datosLogin.titulo %> — Eduplat">
    <meta property="og:description" content="Inicia sesión en Eduplat y accede a tus cursos y progreso.">
    <meta property="og:image" content="/favicon.svg">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= datosLogin.titulo %> — Eduplat">
    <meta name="twitter:description" content="Inicia sesión en Eduplat y accede a tus cursos y progreso.">

    <link rel="manifest" href="/manifest.webmanifest">

    <!-- Preconnect & Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CDN con SRI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <!-- Font Awesome 6 CDN con SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- CSS personalizado con Design System Technical Studio -->
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
</head>

<body>
    <!-- Navbar global -->
    <%- include('partials/navbar') %>

    <main id="main-content" class="auth-page-container">
        <div class="auth-card-clean">
            <div class="text-center mb-4">
                <div class="edu-brand-mark mx-auto mb-3" style="width: 44px; height: 44px; font-size: 1.1rem; border-radius: var(--radius-md);">
                    <i class="fas fa-lock"></i>
                </div>
                <h1 style="font-size: 1.6rem; font-weight: 700; margin-bottom: 0.35rem;"><%= datosLogin.titulo %></h1>
                <p class="text-secondary small mb-0"><%= datosLogin.descripcion %></p>
            </div>

            <!-- Mensajes flash -->
            <% if(locals.success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2 px-3 rounded-2" role="alert" style="font-size: 0.88rem;">
                    <i class="fas fa-check-circle"></i> <%= success_msg %>
                </div>
            <% } %>

            <% if(locals.error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3 rounded-2" role="alert" style="font-size: 0.88rem;">
                    <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
                </div>
            <% } %>

            <% if(locals.error && error.length > 0) { %>
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3 rounded-2" role="alert" style="font-size: 0.88rem;">
                    <i class="fas fa-exclamation-circle"></i> <%= error %>
                </div>
            <% } %>

            <!-- Formulario de Login -->
            <form id="form-login" action="/login" method="POST" novalidate>
                <div class="mb-3">
                    <label for="email" class="form-label">Correo electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-subtle); border-radius: var(--radius-sm) 0 0 var(--radius-sm);">
                            <i class="far fa-envelope"></i>
                        </span>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            placeholder="nombre@ejemplo.com"
                            required
                            autocomplete="email"
                            style="border-radius: 0 var(--radius-sm) var(--radius-sm) 0;"
                        >
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="password" class="form-label mb-0">Contraseña</label>
                        <a href="/olvide-password" class="small text-decoration-none text-primary" style="font-size: 0.8rem;">¿Olvidaste tu contraseña?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-subtle); border-radius: var(--radius-sm) 0 0 var(--radius-sm);">
                            <i class="fas fa-key" style="font-size: 0.85rem;"></i>
                        </span>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control border-end-0"
                            placeholder="••••••••••••"
                            required
                            autocomplete="current-password"
                        >
                        <button class="btn btn-outline-secondary border-start-0 bg-white" type="button" id="toggle-password" tabindex="0" aria-label="Mostrar u ocultar contraseña" style="border-color: var(--border-subtle); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; color: var(--text-muted);">
                            <i class="fas fa-eye" id="eye-icon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-edu-primary w-100 py-2 mb-3" id="btn-login">
                    <span>Iniciar Sesión</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </form>

            <div class="d-flex align-items-center gap-2 my-3 text-muted" style="font-size: 0.85rem;">
                <div class="flex-grow-1 border-top" style="border-color: var(--border-subtle) !important;"></div>
                <span>o</span>
                <div class="flex-grow-1 border-top" style="border-color: var(--border-subtle) !important;"></div>
            </div>

            <div class="text-center small text-secondary">
                ¿No tienes cuenta? <a href="/registro" class="fw-semibold text-dark text-decoration-underline">Crear cuenta gratuita</a>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous" defer></script>
    <%- include('partials/sw-register') %>
    <script>
        const toggleBtn = document.getElementById('toggle-password');
        const pwdInput  = document.getElementById('password');
        const eyeIcon   = document.getElementById('eye-icon');

        toggleBtn.addEventListener('click', () => {
            const visible = pwdInput.type === 'text';
            pwdInput.type = visible ? 'password' : 'text';
            eyeIcon.className = visible ? 'fas fa-eye' : 'fas fa-eye-slash';
        });

        document.getElementById('form-login').addEventListener('submit', function() {
            const btn = document.getElementById('btn-login');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span><span>Ingresando...</span>';
            btn.disabled = true;
        });
    </script>
</body>

</html>
