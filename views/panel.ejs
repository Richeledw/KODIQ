<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Panel — Eduplat</title>

    <!-- Bootstrap 5 CDN con SRI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <!-- Font Awesome 6 CDN con SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- CSS personalizado con Design System Technical Studio -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        .panel-nav-item {
            padding: 0.85rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--text-secondary);
            text-decoration: none;
            font-family: var(--font-heading);
            font-weight: 600;
            font-size: 0.9rem;
            border-bottom: 1px solid var(--border-subtle);
            border-left: 3px solid transparent;
            transition: all 0.15s ease;
        }

        .panel-nav-item:last-child {
            border-bottom: none;
        }

        .panel-nav-item:hover {
            background-color: var(--surface-subtle);
            color: var(--text-primary);
        }

        .panel-nav-item.active {
            background-color: var(--brand-primary-subtle);
            color: var(--brand-primary);
            border-left-color: var(--brand-primary);
        }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
</head>

<body>
    <!-- Header/Navbar -->
    <%- include('partials/navbar') %>

    <main id="main-content" style="background-color: var(--canvas-bg);">
        <!-- Header Panel (Technical Studio Clean Profile) -->
        <section class="py-4 bg-white border-bottom" style="border-color: var(--border-subtle) !important;">
            <div class="container py-2">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="user-avatar-badge" style="width: 58px; height: 58px; background: var(--brand-dark); color: #fff; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; font-weight: 700; font-family: var(--font-mono);">
                            <%= user.nombre ? user.nombre.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h1 class="h3 mb-0"><%= user.nombre %></h1>
                                <span class="course-meta-badge"><%= user.rol %></span>
                            </div>
                            <p class="text-secondary small mb-0 font-mono"><%= user.email %></p>
                            <small class="text-muted" style="font-size: 0.78rem;">
                                Miembro desde <%= new Date(user.creadoEn || Date.now()).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                            </small>
                        </div>
                    </div>
                    <div>
                        <a href="/configuracion" class="btn-edu-secondary py-2 px-3">
                            <i class="fas fa-sliders-h text-muted"></i>
                            <span>Ajustes de Perfil</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="py-4">
            <div class="container">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="stat-card">
                            <div class="stat-icon primary"><i class="fas fa-graduation-cap"></i></div>
                            <div class="stat-info">
                                <h3><%= totalCursos %></h3>
                                <p>Cursos Inscritos</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card">
                            <div class="stat-icon success"><i class="fas fa-chart-line"></i></div>
                            <div class="stat-info">
                                <h3><%= progresoPromedio %>%</h3>
                                <p>Progreso General</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card">
                            <div class="stat-icon warning"><i class="fas fa-check-circle"></i></div>
                            <div class="stat-info">
                                <h3><%= locals.leccionesTotalesCompletadas !== undefined ? leccionesTotalesCompletadas : 0 %></h3>
                                <p>Lecciones Vistas</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card">
                            <div class="stat-icon dark"><i class="fas fa-award"></i></div>
                            <div class="stat-info">
                                <h3><%= locals.proyectosCompletados !== undefined ? proyectosCompletados : 0 %></h3>
                                <p>Proyectos Aprobados</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="container py-4">
            <div class="row g-4">
                <!-- Sidebar Navegación Interna -->
                <div class="col-lg-3">
                    <div class="bg-white border rounded-3 overflow-hidden shadow-sm" style="border-color: var(--border-subtle) !important;">
                        <a href="/panel" class="panel-nav-item active">
                            <i class="fas fa-book-open"></i>
                            <span>Mis Cursos</span>
                        </a>
                        <a href="/configuracion" class="panel-nav-item">
                            <i class="fas fa-sliders-h"></i>
                            <span>Configuración</span>
                        </a>
                        <a href="/temas" class="panel-nav-item">
                            <i class="fas fa-compass"></i>
                            <span>Explorar Catálogo</span>
                        </a>
                        <a href="/contacto" class="panel-nav-item">
                            <i class="far fa-envelope"></i>
                            <span>Centro de Soporte</span>
                        </a>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="col-lg-9">
                    <!-- Mis Cursos -->
                    <div class="data-card">
                        <div class="data-card-header">
                            <h2 class="h5 mb-0">Cursos en Curso</h2>
                            <span class="course-meta-badge"><%= cursosInscritos.length %> activos</span>
                        </div>
                        <div class="data-card-body">
                            <% if(cursosInscritos.length > 0) { %>
                                <div class="row g-4">
                                    <% cursosInscritos.forEach(curso => { %>
                                        <div class="col-md-6">
                                            <div class="course-card-pro">
                                                <div class="course-card-top">
                                                    <div class="tech-icon-container">
                                                        <img src="<%= curso.icono %>" alt="<%= curso.titulo %>">
                                                    </div>
                                                    <span class="course-meta-badge"><%= curso.progreso %>%</span>
                                                </div>
                                                <div class="course-card-body">
                                                    <h3 class="course-card-title"><%= curso.titulo %></h3>
                                                    <p class="course-card-desc"><%= curso.descripcion %></p>
                                                    
                                                    <!-- Barra de Progreso Minimalista -->
                                                    <div class="mb-3">
                                                        <div class="progress" style="height: 5px; background-color: var(--surface-subtle);">
                                                            <div class="progress-bar" style="width: <%= curso.progreso %>%; background-color: var(--brand-primary);" role="progressbar"></div>
                                                        </div>
                                                    </div>

                                                    <div class="d-flex align-items-center justify-content-between mt-auto pt-2">
                                                        <a href="/curso/<%= curso.id %>/aula" class="btn-edu-accent py-2 px-3 w-100 text-center">
                                                            <i class="fas fa-play-circle me-1"></i>
                                                            <span>Ingresar al Aula</span>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-5">
                                    <div class="tech-icon-container mx-auto mb-3" style="width: 48px; height: 48px;">
                                        <i class="fas fa-book-open text-muted"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-1">Aún no te has inscrito en ningún curso</h5>
                                    <p class="text-secondary small mb-4">Explora las rutas formativas disponibles y comienza tu formación técnica.</p>
                                    <a href="/temas" class="btn-edu-primary">
                                        <span>Explorar Catálogo</span>
                                        <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="edu-footer">
        <div class="container text-center text-muted small">
            <span>&copy; <%= new Date().getFullYear() %> Eduplat. Plataforma de Ingeniería de Software.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
</body>

</html>
