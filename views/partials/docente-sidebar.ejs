<!-- Sidebar de Docente EduPlat — Technical Studio Edition -->
<aside class="sidebar">
    <a class="sidebar-brand" href="/docente/dashboard">
        <div class="brand-icon">
            <i class="fas fa-terminal"></i>
        </div>
        <div>
            <span class="brand-name">Eduplat</span>
            <small class="brand-sub">Panel Docente</small>
        </div>
    </a>

    <p class="nav-section-label">Principal</p>
    <a href="/docente/dashboard" class="nav-link <%= (locals.activeTab === 'dashboard') ? 'active' : '' %>">
        <i class="fas fa-chart-pie"></i>
        <span>Mis Cursos</span>
    </a>
    <a href="/docente/cursos/nuevo" class="nav-link <%= (locals.activeTab === 'nuevo-curso') ? 'active' : '' %>">
        <i class="fas fa-plus-circle"></i>
        <span>Publicar Curso</span>
    </a>

    <p class="nav-section-label">Estudiantes & Feedback</p>
    <a href="/docente/proyectos" class="nav-link <%= (locals.activeTab === 'proyectos') ? 'active' : '' %>">
        <i class="fas fa-laptop-code"></i>
        <span>Proyectos de Alumnos</span>
    </a>

    <p class="nav-section-label">Plataforma</p>
    <a href="/temas" class="nav-link">
        <i class="fas fa-graduation-cap"></i>
        <span>Ver Catálogo</span>
    </a>
    <a href="/panel" class="nav-link">
        <i class="fas fa-user-graduate"></i>
        <span>Mi Panel Estudiante</span>
    </a>

    <div class="sidebar-footer">
        <div class="user-info d-flex align-items-center gap-2">
            <div class="user-avatar-badge" style="width:34px;height:34px;background:var(--brand-dark);color:white;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:0.85rem;font-weight:700;font-family:var(--font-mono);">
                <i class="fas fa-chalkboard-teacher"></i>
            </div>
            <div style="min-width:0;" class="flex-grow-1">
                <div class="text-truncate user-display-name fw-semibold text-dark" style="font-size:.85rem;">
                    <%= locals.user ? user.nombre : 'Docente' %>
                </div>
                <div class="font-mono text-muted" style="font-size:.72rem;">Docente</div>
            </div>
        </div>
        <form action="/logout" method="POST" class="m-0 mt-1">
            <button type="submit" class="nav-link text-danger btn-logout border-0 bg-transparent w-100 text-start">
                <i class="fas fa-sign-out-alt"></i>
                <span>Cerrar sesión</span>
            </button>
        </form>
    </div>
</aside>
