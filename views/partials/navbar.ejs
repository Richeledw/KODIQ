<!-- Navbar Dinámico EduPlat — Technical Studio Edition (SSR + CSR Auth Sync) -->
<a href="#main-content" class="skip-link">Saltar al contenido principal</a>
<header class="edu-navbar sticky-top">
    <nav class="navbar navbar-expand-lg container-fluid px-lg-4 py-2" aria-label="Navegación principal">
        <a class="edu-brand" href="/">
            <div class="edu-brand-mark">
                <i class="fas fa-terminal"></i>
            </div>
            <span>Eduplat</span>
        </a>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir menú de navegación">
            <i class="fas fa-bars text-dark"></i>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                <li class="nav-item">
                    <a class="edu-nav-link" href="/">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="edu-nav-link" href="/temas">Cursos</a>
                </li>
                <li class="nav-item">
                    <a class="edu-nav-link" href="/contacto">Contacto</a>
                </li>
            </ul>

            <!-- Sección de Autenticación Dinámica Híbrida (SSR + CSR) -->
            <div class="d-flex align-items-center gap-2">
                <% 
                    const isServerAuth = !!(locals.user && user.nombre);
                    let panelPath = '/panel';
                    let panelName = 'Mi Panel';
                    let roleIcon = 'fa-user-graduate';

                    if (isServerAuth) {
                        if (user.rol === 'admin') {
                            panelPath = '/admin/dashboard';
                            panelName = 'Panel Admin';
                            roleIcon = 'fa-user-shield';
                        } else if (user.rol === 'docente' || user.rol === 'teacher') {
                            panelPath = '/docente/dashboard';
                            panelName = 'Panel Docente';
                            roleIcon = 'fa-chalkboard-teacher';
                        }
                    }
                %>

                <!-- 1. BLOQUE USUARIO AUTENTICADO -->
                <div class="nav-auth-user d-flex align-items-center gap-2 <%= isServerAuth ? '' : 'd-none' %>" data-auth="user" <%= isServerAuth ? '' : 'style="display:none !important;"' %>>
                    <a href="<%= panelPath %>" class="btn-edu-secondary link-mi-panel py-2 px-3">
                        <i class="fas <%= roleIcon %> text-muted link-mi-panel-icon"></i>
                        <span class="link-mi-panel-text"><%= panelName %></span>
                    </a>

                    <div class="dropdown">
                        <button class="btn btn-white dropdown-toggle d-flex align-items-center gap-2 border px-3 py-2 shadow-sm rounded-2" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú del usuario">
                            <div class="user-avatar-badge" style="width:26px;height:26px;background:var(--brand-dark);color:white;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;font-family:var(--font-mono);">
                                <%= isServerAuth ? user.nombre.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <span class="fw-semibold text-dark text-truncate user-display-name" style="max-width: 140px; font-size: 0.9rem;">
                                <%= isServerAuth ? user.nombre : 'Usuario' %>
                            </span>
                            <span class="course-meta-badge user-role-badge" style="font-size: 0.65rem;">
                                <%= isServerAuth ? user.rol : 'estudiante' %>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border mt-2" aria-labelledby="userMenuDropdown">
                            <li>
                                <div class="px-3 py-2 border-bottom bg-light">
                                    <div class="fw-bold text-dark user-display-name" style="font-size: 0.9rem;"><%= isServerAuth ? user.nombre : 'Usuario' %></div>
                                    <small class="text-muted font-mono user-email-display" style="font-size: 0.75rem;"><%= isServerAuth ? user.email : '' %></small>
                                </div>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2 link-mi-panel" href="<%= panelPath %>">
                                    <i class="fas <%= roleIcon %> text-muted link-mi-panel-icon"></i>
                                    <span class="link-mi-panel-text"><%= panelName %></span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/configuracion">
                                    <i class="fas fa-sliders-h text-muted"></i>
                                    <span>Configuración</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <!-- Logout por POST: evita cierres de sesión accidentales por enlaces -->
                                <form action="/logout" method="POST" class="m-0">
                                    <button type="submit" class="dropdown-item py-2 text-danger d-flex align-items-center gap-2 btn-logout">
                                        <i class="fas fa-sign-out-alt"></i>
                                        <span>Cerrar Sesión</span>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- 2. BLOQUE VISITANTE / GUEST -->
                <div class="nav-auth-guest d-flex align-items-center gap-2 <%= isServerAuth ? 'd-none' : '' %>" data-auth="guest" <%= isServerAuth ? 'style="display:none !important;"' : '' %>>
                    <a href="/login" class="btn-edu-secondary py-2 px-3">
                        <span>Iniciar Sesión</span>
                    </a>
                    <a href="/registro" class="btn-edu-primary py-2 px-3">
                        <span>Registrarse</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

<!-- Script para sincronizar persistencia de sesión en localStorage -->
<script>
    <% const usuarioSeguro = locals.user ? { id: user._id, nombre: user.nombre, email: user.email, rol: user.rol } : null; %>
    <%# SEGURIDAD: escapamos <, > y & para que el JSON no pueda cerrar el <script>. %>
    window.EDUPLAT_USER = <%- JSON.stringify(usuarioSeguro).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026') %>;
</script>
<script src="/js/navbar-auth.js"></script>
