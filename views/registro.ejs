<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= datosRegistro.titulo %> — Eduplat</title>
    <meta name="description" content="Crea tu cuenta en Eduplat y comienza a aprender ingeniería de software.">
    <link rel="canonical" href="http://localhost:3000/registro">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#0F172A">

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= datosRegistro.titulo %> — Eduplat">
    <meta property="og:description" content="Crea tu cuenta en Eduplat y comienza a aprender ingeniería de software.">
    <meta property="og:url" content="http://localhost:3000/registro">
    <meta property="og:image" content="/img/logo.svg">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= datosRegistro.titulo %> — Eduplat">
    <meta name="twitter:description" content="Crea tu cuenta en Eduplat y comienza a aprender ingeniería de software.">
    <meta name="twitter:image" content="/img/logo.svg">

    <!-- Bootstrap 5 CDN con SRI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <!-- Font Awesome 6 CDN con SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- CSS personalizado con Design System Technical Studio -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        .rol-selector-pro {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.65rem;
        }

        .rol-option input[type="radio"] {
            display: none;
        }

        .rol-card-pro {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.35rem;
            padding: 0.85rem 0.5rem;
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all 0.15s ease;
            text-align: center;
            background: #FFFFFF;
        }

        .rol-card-pro i {
            font-size: 1.25rem;
            color: var(--text-muted);
            transition: color 0.15s ease;
        }

        .rol-card-pro strong {
            font-size: 0.825rem;
            font-family: var(--font-heading);
            color: var(--text-primary);
        }

        .rol-card-pro small {
            font-size: 0.7rem;
            color: var(--text-muted);
            line-height: 1.2;
        }

        /* Estados activos por rol */
        #rol-estudiante:checked ~ .rol-card-pro {
            border-color: var(--brand-primary);
            background: var(--brand-primary-subtle);
        }
        #rol-estudiante:checked ~ .rol-card-pro i {
            color: var(--brand-primary);
        }

        #rol-docente:checked ~ .rol-card-pro {
            border-color: var(--status-success);
            background: var(--status-success-bg);
        }
        #rol-docente:checked ~ .rol-card-pro i {
            color: var(--status-success);
        }

        #rol-admin:checked ~ .rol-card-pro {
            border-color: var(--brand-dark);
            background: var(--surface-subtle);
        }
        #rol-admin:checked ~ .rol-card-pro i {
            color: var(--brand-dark);
        }

        .rol-card-pro:hover {
            border-color: var(--border-strong);
            transform: translateY(-1px);
        }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
</head>

<body>
    <!-- Navbar global -->
    <%- include('partials/navbar') %>

    <main id="main-content" class="auth-page-container">
        <div class="auth-card-clean" style="max-width: 480px;">
            <div class="text-center mb-4">
                <div class="edu-brand-mark mx-auto mb-3" style="width: 44px; height: 44px; font-size: 1.1rem; border-radius: var(--radius-md);">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h1 style="font-size: 1.6rem; font-weight: 700; margin-bottom: 0.35rem;"><%= datosRegistro.titulo %></h1>
                <p class="text-secondary small mb-0"><%= datosRegistro.descripcion %></p>
            </div>

            <!-- Mensajes flash -->
            <% if(locals.success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2 px-3 rounded-2" role="alert" style="font-size: 0.88rem;">
                    <i class="fas fa-check-circle"></i> <%= success_msg %>
                </div>
            <% } %>

            <% if(locals.error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3 rounded-2" role="alert" style="font-size: 0.88rem;">
                    <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
                </div>
            <% } %>

            <% if(typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="alert alert-danger mb-3 py-2 px-3 rounded-2" role="alert" style="font-size: 0.88rem;">
                    <ul class="mb-0 ps-3">
                        <% errors.forEach(error => { %>
                            <li><%= error.msg %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <!-- Formulario de Registro -->
            <form id="form-registro" action="/registro" method="POST" novalidate>
                <!-- Nombre -->
                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre completo</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-subtle); border-radius: var(--radius-sm) 0 0 var(--radius-sm);">
                            <i class="far fa-user"></i>
                        </span>
                        <input
                            type="text"
                            id="nombre"
                            name="nombre"
                            class="form-control"
                            placeholder="Ada Lovelace"
                            value="<%= typeof nombre !== 'undefined' ? nombre : '' %>"
                            required
                            autocomplete="name"
                            style="border-radius: 0 var(--radius-sm) var(--radius-sm) 0;"
                        >
                    </div>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label">Correo electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-subtle); border-radius: var(--radius-sm) 0 0 var(--radius-sm);">
                            <i class="far fa-envelope"></i>
                        </span>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            placeholder="nombre@ejemplo.com"
                            value="<%= typeof email !== 'undefined' ? email : '' %>"
                            required
                            autocomplete="email"
                            style="border-radius: 0 var(--radius-sm) var(--radius-sm) 0;"
                        >
                    </div>
                </div>

                <!-- Contraseña -->
                <div class="mb-3">
                    <label for="password" class="form-label">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-subtle); border-radius: var(--radius-sm) 0 0 var(--radius-sm);">
                            <i class="fas fa-key" style="font-size: 0.85rem;"></i>
                        </span>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control border-end-0"
                            placeholder="Mínimo 8 caracteres"
                            required
                            autocomplete="new-password"
                        >
                        <button class="btn btn-outline-secondary border-start-0 bg-white" type="button" id="toggle-password" aria-label="Mostrar u ocultar contraseña" tabindex="-1" style="border-color: var(--border-subtle); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; color: var(--text-muted);">
                            <i class="fas fa-eye" id="eye-icon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-edu-primary w-100 py-2 mt-2 mb-3" id="btn-registro">
                    <span>Crear Cuenta Gratuita</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </form>

            <div class="d-flex align-items-center gap-2 my-3 text-muted" style="font-size: 0.85rem;">
                <div class="flex-grow-1 border-top" style="border-color: var(--border-subtle) !important;"></div>
                <span>o</span>
                <div class="flex-grow-1 border-top" style="border-color: var(--border-subtle) !important;"></div>
            </div>

            <div class="text-center small text-secondary">
                ¿Ya tienes una cuenta? <a href="/login" class="fw-semibold text-dark text-decoration-underline">Inicia sesión</a>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
    <%- include('partials/sw-register') %>
    <script>
        const toggleBtn = document.getElementById('toggle-password');
        const pwdInput  = document.getElementById('password');
        const eyeIcon   = document.getElementById('eye-icon');

        toggleBtn.addEventListener('click', () => {
            const visible = pwdInput.type === 'text';
            pwdInput.type = visible ? 'password' : 'text';
            eyeIcon.className = visible ? 'fas fa-eye' : 'fas fa-eye-slash';
        });

        document.getElementById('form-registro').addEventListener('submit', function() {
            const btn = document.getElementById('btn-registro');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span><span>Creando cuenta...</span>';
            btn.disabled = true;
        });
    </script>
</body>

</html>
