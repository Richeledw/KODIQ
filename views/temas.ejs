<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= datosTemas.titulo %> — Eduplat</title>
    <meta name="description" content="Explora todas las rutas y cursos de programación disponibles en Eduplat.">
    <link rel="canonical" href="http://localhost:3000/temas">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="http://localhost:3000/temas">
    <meta property="og:title" content="<%= datosTemas.titulo %> — Eduplat">
    <meta property="og:description" content="Explora todas las rutas y cursos de programación disponibles en Eduplat.">
    <meta property="og:image" content="/favicon.svg">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= datosTemas.titulo %> — Eduplat">
    <meta name="twitter:description" content="Explora todas las rutas y cursos de programación disponibles en Eduplat.">

    <link rel="manifest" href="/manifest.webmanifest">

    <!-- Bootstrap 5 CDN con SRI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <!-- Font Awesome 6 CDN con SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- CSS personalizado con Design System Technical Studio -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        .filter-chip {
            padding: 0.4rem 0.9rem;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 500;
            cursor: pointer;
            border: 1px solid var(--border-subtle);
            background: #FFFFFF;
            color: #52525B;
            transition: all 0.15s ease;
            user-select: none;
        }

        .filter-chip:hover {
            border-color: var(--brand-dark);
            color: var(--brand-dark);
        }

        .filter-chip.active {
            background: var(--brand-dark);
            color: #FFFFFF;
            border-color: var(--brand-dark);
        }

        .search-input-wrapper {
            position: relative;
            max-width: 480px;
            width: 100%;
        }

        .search-input-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #A1A1AA;
            font-size: 0.9rem;
        }

        .search-input-wrapper input {
            padding-left: 38px;
            padding-right: 36px;
            border-radius: 10px;
            border: 1px solid var(--border-subtle);
            font-size: 0.9rem;
            height: 42px;
        }

        .search-input-wrapper input:focus {
            border-color: var(--brand-primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .btn-clear-search {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #A1A1AA;
            font-size: 0.85rem;
            display: none;
            cursor: pointer;
        }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
</head>

<body>
    <!-- Header / Navbar global -->
    <%- include('partials/navbar') %>

    <main id="main-content">
        <!-- Header Section (Technical Studio Minimalist Banner) -->
        <section class="py-5 bg-white border-bottom" style="border-color: var(--border-subtle) !important;">
            <div class="container py-2">
                <div style="max-width: 760px;">
                    <span class="course-meta-badge mb-2 d-inline-block">Catálogo Oficial</span>
                    <h1 class="mb-2 font-heading fw-bold" style="font-size: clamp(2rem, 3.5vw, 2.5rem);"><%= datosTemas.titulo %></h1>
                    <p class="text-secondary lead mb-0" style="font-size: 1.05rem;">
                        <%= datosTemas.descripcion %>
                    </p>
                </div>
            </div>
        </section>

        <!-- Barra de Búsqueda y Filtros en Tiempo Real -->
        <section class="bg-white border-bottom py-3 shadow-xs sticky-top" style="top: 0; z-index: 90; border-color: var(--border-subtle) !important;">
            <div class="container">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <!-- Input de búsqueda -->
                    <div class="search-input-wrapper">
                        <i class="fas fa-search"></i>
                        <input type="text" id="inputBuscarCurso" class="form-control" placeholder="Buscar por tecnología, título o palabra clave...">
                        <button type="button" id="btnClearSearch" class="btn-clear-search" title="Limpiar búsqueda">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <!-- Contador de resultados -->
                    <div class="small font-mono text-muted text-nowrap">
                        <span id="contadorCursos" class="fw-semibold text-dark"><%= datosTemas.cursos.length %></span> cursos encontrados
                    </div>
                </div>

                <!-- Chips de filtrado rápido -->
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-2 border-top">
                    <span class="small font-mono text-muted me-1">CATEGORÍA:</span>
                    <button type="button" class="filter-chip active" data-filter-type="cat" data-filter-val="todos">Todos</button>
                    <button type="button" class="filter-chip" data-filter-type="cat" data-filter-val="web">Web Frontend</button>
                    <button type="button" class="filter-chip" data-filter-type="cat" data-filter-val="backend">Backend & Lógica</button>
                    <button type="button" class="filter-chip" data-filter-type="cat" data-filter-val="datos">Bases de Datos</button>

                    <div class="vr mx-2 d-none d-sm-block" style="height: 18px; color: var(--border-subtle);"></div>

                    <span class="small font-mono text-muted me-1">NIVEL:</span>
                    <button type="button" class="filter-chip active" data-filter-type="lvl" data-filter-val="todos">Todos</button>
                    <button type="button" class="filter-chip" data-filter-type="lvl" data-filter-val="beginner">Principiante</button>
                    <button type="button" class="filter-chip" data-filter-type="lvl" data-filter-val="intermediate">Intermedio</button>
                </div>
            </div>
        </section>

        <!-- Courses Grid Section -->
        <section class="py-5" style="background-color: var(--canvas-bg); min-height: 480px;">
            <div class="container">
                <div class="row g-4" id="contenedorCursos">
                    <% datosTemas.cursos.forEach(curso => { 
                        const nivelLower = (curso.nivel || '').toLowerCase();
                        const catLower = (curso.categoria || '').toLowerCase();
                        const searchContent = `${curso.titulo} ${curso.descripcion} ${curso.id} ${catLower} ${nivelLower}`.toLowerCase();
                    %>
                        <div class="col-md-6 col-lg-4 item-curso" 
                             data-categoria="<%= catLower %>" 
                             data-nivel="<%= nivelLower %>"
                             data-search="<%= searchContent %>">
                            <div class="course-card-pro h-100">
                                <div class="course-card-top">
                                    <div class="tech-icon-container">
                                        <img src="<%= curso.icono %>" alt="<%= curso.titulo %>" onerror="this.src='/img/html5.svg'">
                                    </div>
                                    <span class="course-meta-badge"><%= curso.nivel %></span>
                                </div>
                                <div class="course-card-body d-flex flex-column">
                                    <h2 class="course-card-title" style="font-size: 1.15rem;">
                                        <a href="/curso/<%= curso.id %>" class="text-decoration-none text-dark">
                                            <%= curso.titulo %>
                                        </a>
                                    </h2>
                                    <p class="course-card-desc flex-grow-1">
                                        <%= curso.descripcion %>
                                    </p>

                                    <div class="d-flex align-items-center gap-3 mb-3 font-mono" style="font-size: 0.78rem; color: var(--text-muted);">
                                        <span><i class="fas fa-star text-warning me-1"></i><%= curso.calificacion || '5.0' %> (<%= curso.resenas || 120 %>)</span>
                                        <span>•</span>
                                        <span><i class="far fa-clock me-1"></i><%= curso.duracion || '10 horas' %></span>
                                        <span>•</span>
                                        <span><i class="far fa-folder me-1"></i><%= curso.lecciones || (curso.modulos ? curso.modulos.reduce((acc, m) => acc + (m.lecciones ? m.lecciones.length : 0), 0) : 0) %> lec.</span>
                                    </div>

                                    <div class="mt-auto pt-2">
                                        <% if (datosTemas.inscritosIds && datosTemas.inscritosIds.includes(curso.id)) { %>
                                            <a href="/curso/<%= curso.id %>/aula" class="btn-edu-accent w-100 py-2">
                                                <i class="fas fa-play-circle"></i>
                                                <span>Continuar Aprendiendo</span>
                                            </a>
                                        <% } else { %>
                                            <a href="/curso/<%= curso.id %>" class="btn-edu-primary w-100 py-2">
                                                <span>Ver Plan de Estudios</span>
                                                <i class="fas fa-arrow-right"></i>
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Estado vacío cuando no hay coincidencias -->
                <div id="estadoVacioCursos" class="text-center py-5 d-none">
                    <div class="p-5 bg-white border rounded-4 shadow-sm mx-auto" style="max-width: 520px; border-color: var(--border-subtle) !important;">
                        <i class="fas fa-search fa-3x text-muted mb-3 opacity-50"></i>
                        <h4 class="fw-bold font-heading text-dark mb-2">No se encontraron cursos</h4>
                        <p class="text-secondary small mb-4">No hay resultados que coincidan con tus criterios de búsqueda o filtros seleccionados.</p>
                        <button type="button" id="btnResetFiltros" class="btn btn-outline-primary btn-sm fw-semibold px-3 py-2">
                            <i class="fas fa-undo me-1"></i> Restablecer Filtros
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer (Technical Studio Edition) -->
    <footer class="edu-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="edu-brand mb-2">
                        <div class="edu-brand-mark" style="width:26px; height:26px; font-size:0.75rem;">
                            <i class="fas fa-terminal"></i>
                        </div>
                        <span>Eduplat</span>
                    </div>
                    <p class="small text-muted" style="max-width: 320px;">
                        Plataforma de formación técnica orientada a estándares de la industria y buenas prácticas de desarrollo.
                    </p>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Plataforma</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/">Inicio</a></li>
                        <li class="mb-2"><a href="/temas">Cursos</a></li>
                        <li class="mb-2"><a href="/contacto">Soporte</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Tecnologías</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/curso/javascript">JavaScript</a></li>
                        <li class="mb-2"><a href="/curso/typescript">TypeScript</a></li>
                        <li class="mb-2"><a href="/curso/python">Python</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.85rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.05em;">Contacto</h6>
                    <p class="small text-muted mb-1 font-mono">contacto@eduplat.org</p>
                </div>
            </div>
            <div class="pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                <span>&copy; <%= new Date().getFullYear() %> Eduplat. Todos los derechos reservados.</span>
                <span class="font-mono" style="font-size: 0.75rem;">v1.0 • Technical Studio</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous" defer></script>
    <%- include('partials/sw-register') %>

    <!-- Script de filtrado y búsqueda en tiempo real -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputBuscar = document.getElementById('inputBuscarCurso');
            const btnClear = document.getElementById('btnClearSearch');
            const contadorEl = document.getElementById('contadorCursos');
            const items = document.querySelectorAll('.item-curso');
            const estadoVacio = document.getElementById('estadoVacioCursos');
            const btnReset = document.getElementById('btnResetFiltros');
            const chips = document.querySelectorAll('.filter-chip');

            let filtroCat = 'todos';
            let filtroLvl = 'todos';

            function aplicarFiltros() {
                const query = inputBuscar.value.trim().toLowerCase();
                let visibles = 0;

                items.forEach(item => {
                    const itemSearch = item.getAttribute('data-search') || '';
                    const itemCat = item.getAttribute('data-categoria') || '';
                    const itemLvl = item.getAttribute('data-nivel') || '';

                    const coincideQuery = !query || itemSearch.includes(query);
                    const coincideCat = (filtroCat === 'todos') || itemCat.includes(filtroCat);
                    const coincideLvl = (filtroLvl === 'todos') || itemLvl.includes(filtroLvl);

                    if (coincideQuery && coincideCat && coincideLvl) {
                        item.style.display = '';
                        visibles++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                contadorEl.textContent = visibles;
                btnClear.style.display = query.length > 0 ? 'block' : 'none';

                if (visibles === 0) {
                    estadoVacio.classList.remove('d-none');
                } else {
                    estadoVacio.classList.add('d-none');
                }
            }

            inputBuscar.addEventListener('input', aplicarFiltros);

            btnClear.addEventListener('click', function () {
                inputBuscar.value = '';
                aplicarFiltros();
                inputBuscar.focus();
            });

            chips.forEach(chip => {
                chip.addEventListener('click', function () {
                    const type = this.getAttribute('data-filter-type');
                    const val = this.getAttribute('data-filter-val');

                    // Desactivar hermanos del mismo tipo
                    document.querySelectorAll(`.filter-chip[data-filter-type="${type}"]`).forEach(c => c.classList.remove('active'));
                    this.classList.add('active');

                    if (type === 'cat') filtroCat = val;
                    if (type === 'lvl') filtroLvl = val;

                    aplicarFiltros();
                });
            });

            btnReset.addEventListener('click', function () {
                inputBuscar.value = '';
                filtroCat = 'todos';
                filtroLvl = 'todos';

                document.querySelectorAll('.filter-chip').forEach(c => {
                    if (c.getAttribute('data-filter-val') === 'todos') {
                        c.classList.add('active');
                    } else {
                        c.classList.remove('active');
                    }
                });

                aplicarFiltros();
            });
        });
    </script>
</body>

</html>
